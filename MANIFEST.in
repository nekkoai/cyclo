include CHANGELOG.md
include LICENSE
include README.md
include SECURITY.md
include pyproject.toml
include tools/release-acceptance
include tools/build-release
include tools/dependency-audit
include tools/runtime-write-acceptance
include tools/normalize-distributions
include tools/release-manifest
include tools/secret-scan

recursive-include .github *.yml
recursive-include docs *.md
include docs/assets/cyclo-logo.svg
recursive-include requirements *.in *.txt
recursive-include template README.md team *.md
recursive-include tests *.py *.mjs

include src/cyclo/components/__init__.py
include src/cyclo/components/README.md
graft src/cyclo/components/protocol/component
graft src/cyclo/components/protocol/provider
graft src/cyclo/components/gateway
graft src/cyclo/components/passthrough
graft src/cyclo/components/pi-provider
graft src/cyclo/components/team-runtime
prune src/cyclo/components/protocol/component/node_modules
prune src/cyclo/components/protocol/provider/node_modules
prune src/cyclo/components/gateway/node_modules
prune src/cyclo/components/passthrough/node_modules
prune src/cyclo/components/pi-provider/node_modules
prune src/cyclo/components/team-runtime/node_modules
