#!/bin/sh
# Exercise a supplied Cyclo wheel, or build one for a standalone source check,
# as an installed application in an otherwise empty home.
set -eu

fail() {
    printf '%s\n' "release acceptance: $*" >&2
    exit 1
}

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
repo_root=$(CDPATH= cd -- "$script_dir/.." && pwd)
python=${PYTHON:-python3}
build_python=${CYCLO_RELEASE_BUILD_PYTHON:-}
provided_wheel=${1:-}

[ "$#" -le 1 ] \
    || fail "usage: tools/release-acceptance [WHEEL]"

command -v "$python" >/dev/null 2>&1 || fail "Python not found: $python"
command -v git >/dev/null 2>&1 || fail "Git is required"

"$python" -c '
import sys
if sys.version_info < (3, 10):
    raise SystemExit("Cyclo requires Python 3.10 or newer")
'

work_root=$(mktemp -d "${TMPDIR:-/tmp}/cyclo-release-acceptance.XXXXXX")
cleanup() {
    status=$?
    trap - 0
    rm -rf -- "$work_root"
    exit "$status"
}
trap cleanup 0
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

venv=$work_root/venv
build_venv=$work_root/build-venv
dist=$work_root/dist
source_tree=$work_root/source
empty_home=$work_root/home
state_root=$work_root/state
team=$work_root/team
project=$work_root/project
documentation=$work_root/documentation
project_file=$work_root/project.cyclo
project_context=$work_root/project-context.md
doctor_log=$work_root/doctor.log

mkdir -p "$dist" "$source_tree" "$empty_home" "$project" "$documentation"

if [ -z "$provided_wheel" ]; then
    # Build from exactly the files that could enter a source publication. This
    # prevents setuptools from reusing ignored build/lib files deleted from
    # source.
    (
        cd "$repo_root"
        git ls-files --cached --others --exclude-standard |
            while IFS= read -r path; do
                [ -e "$path" ] || continue
                cp -a --parents -- "$path" "$source_tree"
            done
    )
fi
export HOME=$empty_home
export XDG_STATE_HOME=$empty_home/.local/state
unset PYTHONHOME PYTHONPATH \
    CYCLO_TEAM_IMAGE CYCLO_STATE_ROOT \
    PI_CODING_AGENT_DIR \
    AGENTWS_MAX_JOB_ATTEMPTS AGENTWS_MAX_CONSECUTIVE_FAILURES \
    AGENTWS_RETRY_INITIAL_SECONDS AGENTWS_RETRY_MAX_SECONDS
"$python" -m venv "$venv"

if [ -n "$provided_wheel" ]; then
    wheel_directory=$(CDPATH= cd -- "$(dirname -- "$provided_wheel")" && pwd) \
        || fail "wheel directory does not exist: $(dirname -- "$provided_wheel")"
    wheel=$wheel_directory/$(basename -- "$provided_wheel")
    [ -f "$wheel" ] || fail "wheel does not exist: $wheel"
    case $(basename -- "$wheel") in
        cyclo_agent-*.whl) ;;
        *) fail "unexpected Cyclo wheel filename: $wheel" ;;
    esac
    printf '%s\n' "==> using supplied release wheel: $wheel"
else
    if [ -z "$build_python" ]; then
        printf '%s\n' '==> installing hash-locked build backend'
        "$python" -m venv "$build_venv"
        "$build_venv/bin/python" -m pip install \
            --disable-pip-version-check \
            --require-hashes \
            --requirement "$repo_root/requirements/release.txt"
        build_python=$build_venv/bin/python
    fi
    command -v "$build_python" >/dev/null 2>&1 \
        || fail "build Python not found: $build_python"
    "$build_python" - "$repo_root/pyproject.toml" <<'PY'
from importlib.metadata import version
from pathlib import Path
import sys

try:
    import tomllib
except ModuleNotFoundError:
    import tomli as tomllib

with Path(sys.argv[1]).open("rb") as stream:
    requirements = tomllib.load(stream)["build-system"]["requires"]
expected = {}
for requirement in requirements:
    name, separator, expected_version = requirement.partition("==")
    if not separator or not name or not expected_version:
        raise SystemExit(f"release build backend is not exactly pinned: {requirement}")
    expected[name] = expected_version
actual = {name: version(name) for name in expected}
if actual != expected:
    raise SystemExit(f"release build backend mismatch: expected {expected}, found {actual}")
PY

    printf '%s\n' '==> building release wheel'
    "$build_python" -m pip wheel \
        --disable-pip-version-check \
        --no-build-isolation \
        --no-deps \
        --wheel-dir "$dist" \
        "$source_tree"

    set -- "$dist"/cyclo_agent-*.whl
    [ "$#" -eq 1 ] && [ -f "$1" ] \
        || fail "expected exactly one Cyclo wheel in $dist"
    wheel=$1
fi

printf '%s\n' '==> auditing wheel contents'
"$venv/bin/python" - "$wheel" "$repo_root" <<'PY'
import sys
import zipfile
from pathlib import Path

wheel = sys.argv[1]
component_root = Path(sys.argv[2]) / "src" / "cyclo" / "components"
component_sources = (
    "protocol/component",
    "protocol/provider",
    "gateway",
    "passthrough",
    "pi-provider",
    "team-runtime",
)
forbidden_names = {
    "cyclo/provenance.py",
    "cyclo/runtime.lock.json",
    "cyclo/_agentws/LICENSE",
    "cyclo/_agentws/UPSTREAM.json",
}
required_names = {
    "cyclo/component.py",
    "cyclo/component_runtime.py",
    "cyclo/gateway.py",
    "cyclo/project.py",
    "cyclo/providers.py",
}
forbidden_names.add("cyclo/component_stack.py")
owned_sources = [component_root / "__init__.py"]
for component in component_sources:
    owned_sources.extend((component_root / component).rglob("*"))
required_names.update(
    (Path("cyclo/components") / path.relative_to(component_root)).as_posix()
    for path in owned_sources
    if path.is_file()
    and "node_modules" not in path.parts
    and "__pycache__" not in path.parts
    and path.suffix not in {".pyc", ".pyo"}
)
legacy_package_prefix = "cyclo/" + "vendor" + "_gateway/"
upstream_https = b"github" + b".com/glguida/"
upstream_ssh = b"git@" + b"github.com:glguida/"
private_home = b"/home/" + b"glguida"
forbidden_content = (
    upstream_https + b"agentws",
    upstream_https + b"multiagent",
    upstream_ssh + b"agentws",
    upstream_ssh + b"multiagent",
    private_home,
    b"source_" + b"repository",
    b"source_" + b"commit",
)

problems = []
with zipfile.ZipFile(wheel) as archive:
    names = set(archive.namelist())
    problems.extend(sorted(names & forbidden_names))
    problems.extend(
        f"missing required wheel resource: {name}"
        for name in sorted(required_names - names)
    )
    problems.extend(
        f"legacy package path remains: {name}"
        for name in sorted(names)
        if name.startswith(legacy_package_prefix)
    )
    problems.extend(
        f"installed dependency tree leaked into wheel: {name}"
        for name in sorted(names)
        if "node_modules" in Path(name).parts
    )
    for name in sorted(names):
        data = archive.read(name)
        for marker in forbidden_content:
            if marker in data:
                problems.append(f"{name}: contains forbidden publication metadata")

if problems:
    for problem in problems:
        print(problem, file=sys.stderr)
    raise SystemExit("release wheel content audit failed")
PY

printf '%s\n' '==> installing wheel into isolated environment'
"$venv/bin/python" -m pip install \
    --disable-pip-version-check \
    --no-deps \
    --force-reinstall \
    "$wheel"

# From here on, neither the source checkout nor user-local executables are on
# Python's or the shell's search path. Git and Docker remain available from
# ordinary system locations.
export PATH=$venv/bin:/usr/local/bin:/usr/bin:/bin:/snap/bin
cd "$work_root"

cyclo=$venv/bin/cyclo
installed_root=$(
    "$venv/bin/python" -c 'import pathlib, cyclo; print(pathlib.Path(cyclo.__file__).resolve().parent)'
)
case $installed_root in
    "$venv"/*) ;;
    *) fail "Cyclo imported outside the isolated environment: $installed_root" ;;
esac

printf '%s\n' '==> checking wheel-only commands and package resources'
[ "$("$cyclo" --version)" = "cyclo 0.2.0" ] \
    || fail "installed command reports an unexpected release version"
"$venv/bin/python" -c '
from importlib.metadata import distribution
dist = distribution("cyclo-agent")
assert dist.metadata["Name"] == "cyclo-agent"
assert dist.version == "0.2.0"
import cyclo
assert cyclo.__version__ == dist.version
'

gateway_help=$("$cyclo" gateway --help | tr '\n' ' ' | sed 's/[[:space:]][[:space:]]*/ /g')
case $gateway_help in
    *destroy-store*) ;;
    *) fail "installed gateway help is incomplete" ;;
esac
case $gateway_help in
    *providers*) ;;
    *) fail "installed gateway help omits pre-login provider discovery" ;;
esac
case $gateway_help in
    *restart*) ;;
    *) fail "installed gateway help omits gateway restart" ;;
esac
case $gateway_help in
    *"credentials, subscriptions, and retained usage history"*) ;;
    *) fail "installed gateway help does not disclose all retained store data" ;;
esac
providers_help=$("$cyclo" gateway providers --help | tr '\n' ' ' | sed 's/[[:space:]][[:space:]]*/ /g')
case $providers_help in
    *"Providers are upstream AI services"*"does not read or mount the gateway credential store"*) ;;
    *) fail "installed provider-discovery help omits its credential-free guarantee" ;;
esac
login_help=$("$cyclo" gateway login --help | tr '\n' ' ' | sed 's/[[:space:]][[:space:]]*/ /g')
case $login_help in
    *"catalogue provider/account name"*"default: PROVIDER"*) ;;
    *) fail "installed gateway login help does not explain account naming" ;;
esac
models_help=$("$cyclo" models --help | tr '\n' ' ' | sed 's/[[:space:]][[:space:]]*/ /g')
case $models_help in
    *"cyclo gateway providers"*) ;;
    *) fail "installed models help omits pre-login provider discovery" ;;
esac
component_help=$("$cyclo" component --help | tr '\n' ' ' | sed 's/[[:space:]][[:space:]]*/ /g')
case $component_help in
    *"list"*"status"*"build"*"start"*"stop"*"restart"*"logs"*) ;;
    *) fail "installed component lifecycle help is incomplete" ;;
esac
destroy_help=$("$cyclo" gateway destroy-store --help | tr '\n' ' ' | sed 's/[[:space:]][[:space:]]*/ /g')
case $destroy_help in
    *"--confirm VOLUME"*) ;;
    *) fail "installed store-destruction confirmation help is incomplete" ;;
esac
case $destroy_help in
    *"credentials, subscriptions, and retained usage history"*irreversib*|*irreversib*"credentials, subscriptions, and retained usage history"*) ;;
    *) fail "installed store-destruction help does not disclose irreversible data loss" ;;
esac

templates=$("$cyclo" team templates)
expected_templates=$(printf '%s\n' \
    adversarial-audit \
    plan-execute-verify \
    test-driven-repair)
[ "$templates" = "$expected_templates" ] || {
    printf '%s\n' "unexpected template list:" "$templates" >&2
    fail "packaged templates are incomplete"
}

"$cyclo" team init "$team" \
    --template test-driven-repair \
    --model openai-codex/release-acceptance
"$cyclo" validate "$team"

printf '%s\n' \
    'release-acceptance-context-marker' \
    'Use `/workspace/source` for implementation work.' \
    > "$project_context"
"$cyclo" project init "$project_file" \
    --name release-acceptance \
    --description 'Exercise packaged multi-mount project definitions.' \
    --context "$project_context" \
    --team "$team" ro \
    --mount source "$project" rw \
    --mount documentation "$documentation" ro
"$cyclo" validate "$project_file"
grep -F 'release-acceptance-context-marker' "$project_file" >/dev/null \
    || fail "project init omitted its embedded context"

project_dry_run=$(
    "$cyclo" --state-root "$state_root" run \
        --dry-run \
        "$project_file"
)
printf '%s\n' "$project_dry_run"
expected_team_image=$(
    "$venv/bin/python" -c \
        'import pathlib, sys; from cyclo.installation import team_image_name; from cyclo.state import StateStore; print(team_image_name(StateStore(pathlib.Path(sys.argv[1])).system, "0.2.0"))' \
        "$state_root"
)
case $project_dry_run in
    *"dst=/workspace,readonly"*) ;;
    *) fail "project.cyclo dry-run did not make the workspace namespace read-only" ;;
esac
case $project_dry_run in
    *"dst=/readonly,readonly"*) ;;
    *) fail "project.cyclo dry-run did not make the read-only namespace inert" ;;
esac
case $project_dry_run in
    *"type=bind,src=$project,dst=/workspace/source"*) ;;
    *) fail "project.cyclo dry-run omitted its writable source mount" ;;
esac
case $project_dry_run in
    *"type=bind,src=$documentation,dst=/readonly/documentation,readonly"*) ;;
    *) fail "project.cyclo dry-run omitted its read-only documentation mount" ;;
esac
case $project_dry_run in
    *"CYCLO_PROJECT_MANIFEST="*) fail "project context path was unexpectedly configurable" ;;
esac

case $project_dry_run in
    *" $expected_team_image python3 /agentws/.cyclo-runtime.py"*) ;;
    *) fail "project.cyclo dry-run did not use the packaged Cyclo team image" ;;
esac
case $project_dry_run in
    *multiagent*|*"$HOME/agentws"*|*"$HOME/multiagent"*)
        fail "dry-run referenced an external upstream checkout"
        ;;
esac

printf '%s\n' '==> checking installed runtime'
doctor_status=0
"$cyclo" --state-root "$state_root" doctor >"$doctor_log" 2>&1 || doctor_status=$?
cat "$doctor_log"

grep -F 'ok  bundled AgentWS ABI:' "$doctor_log" >/dev/null \
    || fail "doctor did not find the packaged AgentWS runtime"
grep -F 'ok  component ABI:' "$doctor_log" >/dev/null \
    || fail "doctor did not find the packaged component runtime"

if command -v docker >/dev/null 2>&1 && docker info >/dev/null 2>&1; then
    [ "$doctor_status" -eq 1 ] \
        || fail "doctor returned $doctor_status with an intentionally absent gateway"
    grep -F 'ok  Docker daemon:' "$doctor_log" >/dev/null \
        || fail "doctor did not accept the Docker daemon"
    grep -F 'no  credential gateway: absent' "$doctor_log" >/dev/null \
        || fail "doctor did not diagnose the intentionally absent gateway"
else
    [ "$doctor_status" -eq 1 ] \
        || fail "doctor returned $doctor_status when Docker was unavailable"
    if grep -F 'no  Docker daemon:' "$doctor_log" >/dev/null; then
        :
    elif grep -F 'error: Docker is not installed or not on PATH' "$doctor_log" >/dev/null; then
        :
    else
        fail "doctor did not report the unavailable Docker dependency"
    fi
    printf '%s\n' 'SKIP: Docker daemon is unavailable; wheel integrity checks passed.'
fi

printf '%s\n' 'release acceptance: PASS'
