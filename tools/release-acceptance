#!/bin/sh
# Audit a Cyclo wheel as an installed application. DComp/Docker integration is
# opt-in because DComp is a separately installed release prerequisite.
set -eu

fail() {
    printf '%s\n' "release acceptance: $*" >&2
    exit 1
}

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
repo_root=$(CDPATH= cd -- "$script_dir/.." && pwd)
python=${PYTHON:-python3}
build_python=${CYCLO_RELEASE_BUILD_PYTHON:-}
provided_wheel=${1:-}
require_dcomp=${CYCLO_RELEASE_REQUIRE_DCOMP:-0}

[ "$#" -le 1 ] \
    || fail "usage: tools/release-acceptance [WHEEL]"
case $require_dcomp in
    0|1) ;;
    *) fail "CYCLO_RELEASE_REQUIRE_DCOMP must be 0 or 1" ;;
esac

command -v "$python" >/dev/null 2>&1 || fail "Python not found: $python"
command -v git >/dev/null 2>&1 || fail "Git is required"

"$python" -c '
import sys
if sys.version_info < (3, 10):
    raise SystemExit("Cyclo requires Python 3.10 or newer")
'

dcomp=
if [ "${CYCLO_DCOMP+x}" = x ]; then
    [ -n "$CYCLO_DCOMP" ] || fail "CYCLO_DCOMP is empty"
    dcomp=$(command -v "$CYCLO_DCOMP" 2>/dev/null) \
        || fail "DComp executable not found: $CYCLO_DCOMP"
elif [ "$require_dcomp" -eq 1 ] && command -v dcomp >/dev/null 2>&1; then
    dcomp=$(command -v dcomp)
fi
if [ "$require_dcomp" -eq 1 ] && [ -z "$dcomp" ]; then
    fail "DComp is required; install machine API 1 or set CYCLO_DCOMP"
fi
if [ -n "$dcomp" ]; then
    dcomp=$(CDPATH= cd -- "$(dirname -- "$dcomp")" && pwd)/$(basename -- "$dcomp")
    "$python" - "$dcomp" <<'PY'
import json
import subprocess
import sys

executable = sys.argv[1]
completed = subprocess.run(
    [executable, "version", "--json"],
    check=False,
    capture_output=True,
    text=True,
)
if completed.returncode:
    detail = " ".join((completed.stderr or completed.stdout).split())
    raise SystemExit(
        f"DComp version check failed ({completed.returncode})"
        + (f": {detail}" if detail else "")
    )
try:
    document = json.loads(completed.stdout)
except json.JSONDecodeError as exc:
    raise SystemExit("DComp version did not return JSON") from exc
if (
    not isinstance(document, dict)
    or document.get("api_version") != 1
    or not isinstance(document.get("version"), str)
    or not document["version"]
):
    raise SystemExit(f"DComp machine API 1 is required, found: {document!r}")
PY
    export CYCLO_DCOMP=$dcomp
else
    unset CYCLO_DCOMP
fi

work_root=$(mktemp -d "${TMPDIR:-/tmp}/cyclo-release-acceptance.XXXXXX")
runtime_system=
runtime_volume=
cleanup() {
    status=$?
    trap - 0
    if [ -n "$runtime_system" ] && [ -n "$dcomp" ]; then
        "$dcomp" --state-root "$state_root/dcomp" \
            down "$runtime_system" >/dev/null 2>&1 || true
    fi
    if [ -n "$runtime_volume" ] && command -v docker >/dev/null 2>&1; then
        docker volume rm "$runtime_volume" >/dev/null 2>&1 || true
    fi
    rm -rf -- "$work_root"
    exit "$status"
}
trap cleanup 0
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

venv=$work_root/venv
build_venv=$work_root/build-venv
dist=$work_root/dist
source_tree=$work_root/source
empty_home=$work_root/home
state_root=$work_root/state
team=$work_root/team
project=$work_root/project
documentation=$work_root/documentation
project_file=$work_root/project.cyclo
project_context=$work_root/project-context.md

mkdir -p "$dist" "$source_tree" "$empty_home" "$project" "$documentation"

if [ -z "$provided_wheel" ]; then
    # Build from exactly the files eligible for source publication. This
    # prevents setuptools from reusing ignored build output.
    (
        cd "$repo_root"
        git ls-files --cached --others --exclude-standard |
            while IFS= read -r path; do
                [ -e "$path" ] || continue
                cp -a --parents -- "$path" "$source_tree"
            done
    )
fi

export HOME=$empty_home
export XDG_STATE_HOME=$empty_home/.local/state
unset PYTHONHOME PYTHONPATH \
    CYCLO_TEAM_IMAGE CYCLO_STATE_ROOT \
    PI_CODING_AGENT_DIR \
    AGENTWS_MAX_JOB_ATTEMPTS AGENTWS_MAX_CONSECUTIVE_FAILURES \
    AGENTWS_RETRY_INITIAL_SECONDS AGENTWS_RETRY_MAX_SECONDS
"$python" -m venv "$venv"

if [ -n "$provided_wheel" ]; then
    wheel_directory=$(CDPATH= cd -- "$(dirname -- "$provided_wheel")" && pwd) \
        || fail "wheel directory does not exist: $(dirname -- "$provided_wheel")"
    wheel=$wheel_directory/$(basename -- "$provided_wheel")
    [ -f "$wheel" ] || fail "wheel does not exist: $wheel"
    case $(basename -- "$wheel") in
        cyclo_agent-*.whl) ;;
        *) fail "unexpected Cyclo wheel filename: $wheel" ;;
    esac
    printf '%s\n' "==> using supplied release wheel: $wheel"
else
    if [ -z "$build_python" ]; then
        printf '%s\n' '==> installing hash-locked build backend'
        "$python" -m venv "$build_venv"
        "$build_venv/bin/python" -m pip install \
            --disable-pip-version-check \
            --require-hashes \
            --requirement "$repo_root/requirements/release.txt"
        build_python=$build_venv/bin/python
    fi
    command -v "$build_python" >/dev/null 2>&1 \
        || fail "build Python not found: $build_python"
    "$build_python" - "$repo_root/pyproject.toml" <<'PY'
from importlib.metadata import version
from pathlib import Path
import sys

try:
    import tomllib
except ModuleNotFoundError:
    import tomli as tomllib

with Path(sys.argv[1]).open("rb") as stream:
    requirements = tomllib.load(stream)["build-system"]["requires"]
expected = {}
for requirement in requirements:
    name, separator, expected_version = requirement.partition("==")
    if not separator or not name or not expected_version:
        raise SystemExit(f"release build backend is not exactly pinned: {requirement}")
    expected[name] = expected_version
actual = {name: version(name) for name in expected}
if actual != expected:
    raise SystemExit(f"release build backend mismatch: expected {expected}, found {actual}")
PY

    printf '%s\n' '==> building release wheel'
    "$build_python" -m pip wheel \
        --disable-pip-version-check \
        --no-build-isolation \
        --no-deps \
        --wheel-dir "$dist" \
        "$source_tree"

    set -- "$dist"/cyclo_agent-*.whl
    [ "$#" -eq 1 ] && [ -f "$1" ] \
        || fail "expected exactly one Cyclo wheel in $dist"
    wheel=$1
fi

printf '%s\n' '==> auditing wheel contents'
"$venv/bin/python" - "$wheel" "$repo_root" <<'PY'
import sys
import zipfile
from pathlib import Path

wheel = sys.argv[1]
package_root = Path(sys.argv[2]) / "src" / "cyclo"
forbidden_names = {
    "cyclo/component.py",
    "cyclo/component_runtime.py",
    "cyclo/component_stack.py",
    "cyclo/docker.py",
    "cyclo/docker_engine.py",
    "cyclo/gateway.py",
    "cyclo/health.py",
    "cyclo/instance_lifecycle.py",
    "cyclo/provenance.py",
    "cyclo/providers.py",
    "cyclo/runtime.lock.json",
    "cyclo/team_runtime_image.py",
    "cyclo/agentws_bundle.py",
    "cyclo/agentws_queue.py",
    "cyclo/container_runtime.py",
    "cyclo/pi_runtime.py",
    "cyclo/task_admin.py",
    "cyclo/team.py",
    "cyclo/team_templates.py",
}

required_names = {
    (Path("cyclo") / path.relative_to(package_root)).as_posix()
    for path in package_root.rglob("*")
    if path.is_file()
    and "node_modules" not in path.parts
    and "__pycache__" not in path.parts
    and path.suffix not in {".pyc", ".pyo"}
}

legacy_package_prefixes = (
    "cyclo/" + "vendor" + "_gateway/",
    "cyclo/_agentws/",
    "cyclo/adapters/",
    "cyclo/team_templates/",
)
upstream_https = b"github" + b".com/glguida/"
upstream_ssh = b"git@" + b"github.com:glguida/"
private_home = b"/home/" + b"glguida"
forbidden_content = (
    upstream_https + b"agentws",
    upstream_https + b"multiagent",
    upstream_ssh + b"agentws",
    upstream_ssh + b"multiagent",
    private_home,
    b"source_" + b"repository",
    b"source_" + b"commit",
)

problems = []
with zipfile.ZipFile(wheel) as archive:
    names = set(archive.namelist())
    problems.extend(
        f"obsolete wheel resource remains: {name}"
        for name in sorted(names & forbidden_names)
    )
    problems.extend(
        f"missing required wheel resource: {name}"
        for name in sorted(required_names - names)
    )
    problems.extend(
        f"legacy package path remains: {name}"
        for name in sorted(names)
        if name.startswith(legacy_package_prefixes)
    )
    problems.extend(
        f"installed dependency tree leaked into wheel: {name}"
        for name in sorted(names)
        if "node_modules" in Path(name).parts
    )
    problems.extend(
        f"Python bytecode cache leaked into wheel: {name}"
        for name in sorted(names)
        if "__pycache__" in Path(name).parts
        or Path(name).suffix in {".pyc", ".pyo"}
    )
    for name in sorted(names):
        data = archive.read(name)
        for marker in forbidden_content:
            if marker in data:
                problems.append(f"{name}: contains forbidden publication metadata")

if problems:
    for problem in problems:
        print(problem, file=sys.stderr)
    raise SystemExit("release wheel content audit failed")
PY

printf '%s\n' '==> installing wheel into isolated environment'
"$venv/bin/python" -m pip install \
    --disable-pip-version-check \
    --no-deps \
    --force-reinstall \
    "$wheel"

# The source checkout and user-local Python commands are deliberately absent.
# An explicitly selected DComp remains usable by absolute path.
export PATH=$venv/bin:/usr/local/bin:/usr/bin:/bin:/snap/bin
cd "$work_root"

cyclo=$venv/bin/cyclo
installed_root=$(
    "$venv/bin/python" -c 'import pathlib, cyclo; print(pathlib.Path(cyclo.__file__).resolve().parent)'
)
case $installed_root in
    "$venv"/*) ;;
    *) fail "Cyclo imported outside the isolated environment: $installed_root" ;;
esac

printf '%s\n' '==> checking wheel-only commands and package resources'
[ "$("$cyclo" --version)" = "cyclo 0.2.0" ] \
    || fail "installed command reports an unexpected release version"
"$venv/bin/python" -c '
from importlib.metadata import distribution
dist = distribution("cyclo-agent")
assert dist.metadata["Name"] == "cyclo-agent"
assert dist.version == "0.2.0"
import cyclo
assert cyclo.__version__ == dist.version
'

gateway_help=$("$cyclo" gateway --help)
printf '%s\n' "$gateway_help" | grep -F 'providers' >/dev/null \
    || fail "installed gateway help omits provider discovery"
printf '%s\n' "$gateway_help" | grep -F 'destroy-store' >/dev/null \
    || fail "installed gateway help omits store destruction"
printf '%s\n' "$gateway_help" | grep -F 'build' >/dev/null \
    || fail "installed gateway help omits build-and-apply"

component_help=$("$cyclo" component --help)
for action in list status logs restart; do
    printf '%s\n' "$component_help" | grep -F "$action" >/dev/null \
        || fail "installed component help omits $action"
done
component_words=$(
    printf '%s\n' "$component_help" | tr ' ,{}()' '\n'
)
for obsolete in build start stop; do
    if printf '%s\n' "$component_words" | grep -Fx "$obsolete" >/dev/null; then
        fail "installed component help exposes obsolete $obsolete lifecycle"
    fi
done

run_help=$("$cyclo" run --help)
if printf '%s\n' "$run_help" | grep -F -- '--dry-run' >/dev/null; then
    fail "installed run help exposes obsolete --dry-run"
fi

providers_help=$("$cyclo" providers --help)
for action in check status restart; do
    printf '%s\n' "$providers_help" | grep -F "$action" >/dev/null \
        || fail "installed providers help omits $action"
done

templates=$("$cyclo" team templates)
expected_templates=$(printf '%s\n' \
    adversarial-audit \
    plan-execute-verify \
    test-driven-repair)
[ "$templates" = "$expected_templates" ] || {
    printf '%s\n' "unexpected template list:" "$templates" >&2
    fail "packaged templates are incomplete"
}

"$cyclo" team init "$team" \
    --template test-driven-repair \
    --model openai-codex/release-acceptance
"$cyclo" validate "$team"

printf '%s\n' \
    'release-acceptance-context-marker' \
    'Use `/workspace/source` for implementation work.' \
    > "$project_context"
"$cyclo" project init "$project_file" \
    --name release-acceptance \
    --description 'Exercise packaged multi-mount project definitions.' \
    --context "$project_context" \
    --team "$team" ro \
    --mount source "$project" rw \
    --mount documentation "$documentation" ro
"$venv/bin/python" - "$project_file" <<'PY'
from pathlib import Path
import sys

from cyclo.project import load_project
from cyclo.project_run import load_project_teams

definition = load_project(Path(sys.argv[1]))
teams = load_project_teams(definition)
assert definition.name == "release-acceptance"
assert len(teams) == 1
assert [mount.name for mount in definition.mounts] == [
    "source",
    "documentation",
]
PY
grep -F 'release-acceptance-context-marker' "$project_file" >/dev/null \
    || fail "project init omitted its embedded context"

if [ "$require_dcomp" -eq 1 ]; then
    printf '%s\n' '==> checking installed DComp/Docker integration'
    command -v docker >/dev/null 2>&1 || fail "Docker is required"
    docker info >/dev/null 2>&1 || fail "the Docker daemon is unavailable"
    mkdir -p "$state_root"
    : > "$state_root/host.conf"
    "$cyclo" --state-root "$state_root" validate "$project_file"
    system=$(
        "$venv/bin/python" - "$state_root" <<'PY'
from pathlib import Path
import sys
from cyclo.state import StateStore

print(StateStore(Path(sys.argv[1])).system)
PY
    )
    runtime_system=cyclo-$system
    runtime_volume=dcomp.$runtime_system.volume.gateway.credentials

    "$cyclo" --state-root "$state_root" gateway build
    component_status=$(
        "$cyclo" --state-root "$state_root" component status gateway
    )
    printf '%s\n' "$component_status"
    printf '%s\n' "$component_status" | grep -F 'gateway' >/dev/null \
        || fail "DComp status omitted the gateway component"
    doctor_log=$work_root/doctor.log
    "$cyclo" --state-root "$state_root" doctor >"$doctor_log"
    cat "$doctor_log"
    grep -F 'ok  dcomp ' "$doctor_log" >/dev/null \
        || fail "doctor did not report DComp"
    grep -F 'ok  component gateway' "$doctor_log" >/dev/null \
        || fail "doctor did not report a healthy gateway"

    "$cyclo" --state-root "$state_root" gateway destroy-store \
        --confirm "$runtime_volume"
    runtime_system=
    runtime_volume=
else
    printf '%s\n' \
        'SKIP: DComp/Docker integration (set CYCLO_RELEASE_REQUIRE_DCOMP=1).'
fi

printf '%s\n' 'release acceptance: PASS'
