#!/usr/bin/env python3
"""Audit shipped npm locks, allowing two exact temporary Pi findings."""

from __future__ import annotations

import argparse
import json
import re
import subprocess
import sys
import tempfile
from pathlib import Path
from typing import Any


PACKAGES = (
    "components/protocol/component",
    "components/protocol/provider",
    "components/gateway",
    "components/passthrough",
    "components/team/pi",
    "components/team",
)
PI_PACKAGE = "@earendil-works/pi-coding-agent"
PI_VERSION = "0.81.1"
PI_LOCK_PATH = f"node_modules/{PI_PACKAGE}"
WAIVED_VERSIONS = {
    "brace-expansion": "5.0.7",
    "undici": "8.5.0",
}
FIXED_VERSIONS = {
    "brace-expansion": (5, 0, 9),
    "undici": (8, 9, 0),
}
WAIVED_ADVISORIES = {
    "brace-expansion": frozenset(
        {
            ("https://github.com/advisories/GHSA-mh99-v99m-4gvg", "high"),
            ("https://github.com/advisories/GHSA-rgw5-rvv9-x895", "high"),
        }
    ),
    "undici": frozenset(
        {
            ("https://github.com/advisories/GHSA-4cwx-7wf7-3272", "high"),
            ("https://github.com/advisories/GHSA-8xcm-r25x-g524", "moderate"),
            ("https://github.com/advisories/GHSA-m8rv-5g2x-5cg5", "moderate"),
            ("https://github.com/advisories/GHSA-jr45-8vmc-qm54", "moderate"),
            ("https://github.com/advisories/GHSA-v3r7-h72x-cjcm", "moderate"),
        }
    ),
}


class AuditPolicyError(RuntimeError):
    pass


def read_json(path: Path) -> dict[str, Any]:
    try:
        value = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as error:
        raise AuditPolicyError(f"cannot read {path}: {error}") from error
    if not isinstance(value, dict):
        raise AuditPolicyError(f"{path} is not a JSON object")
    return value


def parse_audit_output(output: str, *, source: str) -> dict[str, Any]:
    try:
        report = json.loads(output)
    except json.JSONDecodeError as error:
        raise AuditPolicyError(f"{source} returned malformed JSON") from error
    if (
        not isinstance(report, dict)
        or report.get("auditReportVersion") != 2
        or "error" in report
        or not isinstance(report.get("vulnerabilities"), dict)
        or not isinstance(report.get("metadata"), dict)
        or not isinstance(report["metadata"].get("vulnerabilities"), dict)
    ):
        raise AuditPolicyError(f"{source} returned an invalid or failed audit report")
    return report


def run_audit(package_dir: Path) -> tuple[dict[str, Any], int]:
    completed = subprocess.run(
        [
            "npm",
            "audit",
            "--json",
            "--omit=dev",
            "--package-lock-only",
            "--audit-level=high",
            "--prefix",
            str(package_dir),
        ],
        capture_output=True,
        text=True,
        check=False,
    )
    report = parse_audit_output(completed.stdout, source=f"npm audit ({package_dir})")
    if completed.returncode not in (0, 1):
        raise AuditPolicyError(
            f"npm audit ({package_dir}) failed with status {completed.returncode}"
        )
    return report, completed.returncode


def high_findings(report: dict[str, Any]) -> list[tuple[str, dict[str, Any]]]:
    findings = []
    for name, finding in report["vulnerabilities"].items():
        if not isinstance(name, str) or not isinstance(finding, dict):
            raise AuditPolicyError("npm audit returned an invalid finding")
        severity = finding.get("severity")
        if severity not in {"info", "low", "moderate", "high", "critical"}:
            raise AuditPolicyError(f"npm audit returned an invalid severity for {name}")
        if severity in {"high", "critical"}:
            findings.append((name, finding))

    counts = report["metadata"]["vulnerabilities"]
    if (
        not isinstance(counts.get("high"), int)
        or not isinstance(counts.get("critical"), int)
        or counts["high"] < 0
        or counts["critical"] < 0
        or counts["high"] + counts["critical"] != len(findings)
    ):
        raise AuditPolicyError("npm audit findings disagree with its metadata")
    return findings


def waived_node(package: str) -> str:
    return f"{PI_LOCK_PATH}/node_modules/{package}"


def version_is_fixed(value: object, fixed: tuple[int, int, int]) -> bool:
    if not isinstance(value, str):
        raise AuditPolicyError(f"invalid package version {value!r}")
    match = re.fullmatch(r"(\d+)\.(\d+)\.(\d+)(?:-([0-9A-Za-z.-]+))?(?:\+.*)?", value)
    if match is None:
        raise AuditPolicyError(f"invalid package version {value!r}")
    version = tuple(int(part) for part in match.group(1, 2, 3))
    return version > fixed or (version == fixed and match.group(4) is None)


def validate_waiver_lock(package_dir: Path) -> None:
    package = read_json(package_dir / "package.json")
    packages = read_json(package_dir / "package-lock.json").get("packages")
    if not isinstance(packages, dict):
        raise AuditPolicyError("team component lock has no package map")
    root = packages.get("")
    pi = packages.get(PI_LOCK_PATH)
    declared = package.get("dependencies")
    locked = root.get("dependencies") if isinstance(root, dict) else None
    if (
        not isinstance(declared, dict)
        or declared.get(PI_PACKAGE) != PI_VERSION
        or not isinstance(root, dict)
        or not isinstance(locked, dict)
        or locked.get(PI_PACKAGE) != PI_VERSION
        or not isinstance(pi, dict)
        or pi.get("version") != PI_VERSION
        or pi.get("hasShrinkwrap") is not True
    ):
        raise AuditPolicyError(
            f"temporary waiver requires shrinkwrapped {PI_PACKAGE}@{PI_VERSION} "
            "at the exact declared and locked version"
        )

    for name, expected_version in WAIVED_VERSIONS.items():
        node = waived_node(name)
        nested = packages.get(node)
        if not isinstance(nested, dict) or nested.get("version") != expected_version:
            raise AuditPolicyError(
                f"temporary waiver requires {node}@{expected_version}"
            )
        independent = packages.get(f"node_modules/{name}")
        if isinstance(independent, dict) and not version_is_fixed(
            independent.get("version"), FIXED_VERSIONS[name]
        ):
            raise AuditPolicyError(f"independent {name} copy remains vulnerable")


def exact_advisories(name: str, finding: dict[str, Any]) -> bool:
    via = finding.get("via")
    expected = WAIVED_ADVISORIES[name]
    if not isinstance(via, list) or len(via) != len(expected):
        return False
    actual: set[tuple[str, str]] = set()
    for advisory in via:
        if (
            not isinstance(advisory, dict)
            or advisory.get("name") != name
            or advisory.get("dependency") != name
            or not isinstance(advisory.get("url"), str)
            or not isinstance(advisory.get("severity"), str)
        ):
            return False
        actual.add((advisory["url"], advisory["severity"]))
    return actual == expected


def validate_team_component(
    report: dict[str, Any], returncode: int, package_dir: Path
) -> None:
    findings = high_findings(report)
    if len(findings) != len(WAIVED_VERSIONS):
        raise AuditPolicyError(
            "team component does not have exactly the documented temporary findings"
        )
    if (
        report["metadata"]["vulnerabilities"]["high"] != len(WAIVED_VERSIONS)
        or report["metadata"]["vulnerabilities"]["critical"] != 0
        or returncode != 1
    ):
        raise AuditPolicyError("team component audit result does not match its waiver")

    seen: set[str] = set()
    for name, finding in findings:
        if (
            name not in WAIVED_VERSIONS
            or name in seen
            or finding.get("name") != name
            or finding.get("severity") != "high"
            or finding.get("nodes") != [waived_node(name)]
            or not exact_advisories(name, finding)
        ):
            raise AuditPolicyError(
                "team component findings do not exactly match the documented Pi exception"
            )
        seen.add(name)
    if seen != set(WAIVED_VERSIONS):
        raise AuditPolicyError(
            "team component findings do not exactly match the documented Pi exception"
        )
    validate_waiver_lock(package_dir)


def latest_pi_lock() -> tuple[str, dict[str, Any]]:
    with tempfile.TemporaryDirectory(prefix="cyclo-pi-audit-") as temporary:
        completed = subprocess.run(
            [
                "npm",
                "install",
                "--package-lock-only",
                "--ignore-scripts",
                "--no-audit",
                "--no-fund",
                "--prefix",
                temporary,
                f"{PI_PACKAGE}@latest",
            ],
            capture_output=True,
            text=True,
            check=False,
        )
        if completed.returncode != 0:
            raise AuditPolicyError("cannot inspect the latest published Pi package")
        lock = read_json(Path(temporary) / "package-lock.json")
        packages = lock.get("packages")
        pi = packages.get(PI_LOCK_PATH) if isinstance(packages, dict) else None
        if not isinstance(pi, dict) or not isinstance(pi.get("version"), str):
            raise AuditPolicyError("latest published Pi produced an invalid lock")
        return pi["version"], lock


def validate_no_fixed_pi_release(
    version: str, lock: dict[str, Any]
) -> dict[str, list[str]]:
    packages = lock.get("packages")
    if not isinstance(packages, dict):
        raise AuditPolicyError(f"latest {PI_PACKAGE}@{version} has no package map")
    affected: dict[str, list[str]] = {}
    for name, fixed in FIXED_VERSIONS.items():
        versions = [
            value.get("version")
            for path, value in packages.items()
            if isinstance(path, str)
            and (
                path == f"node_modules/{name}"
                or path.endswith(f"/node_modules/{name}")
            )
            and isinstance(value, dict)
        ]
        vulnerable = [value for value in versions if not version_is_fixed(value, fixed)]
        if not versions or not vulnerable:
            raise AuditPolicyError(
                f"latest {PI_PACKAGE}@{version} fixes {name}; "
                "remove that waiver and update Pi"
            )
        affected[name] = vulnerable
    return affected


def audit_repository(root: Path) -> None:
    package_root = root / "src" / "cyclo"
    for name in PACKAGES:
        package_dir = package_root / name
        report, returncode = run_audit(package_dir)
        if name == "components/team":
            validate_team_component(report, returncode, package_dir)
        else:
            findings = high_findings(report)
            if findings or returncode != 0:
                packages = ", ".join(name for name, _ in findings)
                raise AuditPolicyError(f"{name}: high/critical findings: {packages}")
            print(f"{name}: no high or critical vulnerabilities")

    latest_version, latest_lock = latest_pi_lock()
    affected = validate_no_fixed_pi_release(latest_version, latest_lock)
    waived = "; ".join(
        f"{name}@{WAIVED_VERSIONS[name]} at {waived_node(name)}"
        for name in sorted(WAIVED_VERSIONS)
    )
    latest = "; ".join(
        f"{name} {', '.join(sorted({str(value) for value in versions}))}"
        for name, versions in sorted(affected.items())
    )
    print(
        f"team component: TEMPORARY WAIVER {waived}; "
        f"latest {PI_PACKAGE}@{latest_version} remains affected ({latest})"
    )


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument(
        "root", nargs="?", type=Path, default=Path(__file__).resolve().parents[1]
    )
    arguments = parser.parse_args(argv)
    try:
        audit_repository(arguments.root.resolve())
    except AuditPolicyError as error:
        print(f"dependency audit: {error}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
