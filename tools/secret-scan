#!/usr/bin/env python3
"""Scan the local Git history, worktree, and release artifacts for secrets."""

from __future__ import annotations

import io
import re
import subprocess
import sys
import tarfile
import zipfile
from pathlib import Path
from typing import BinaryIO


ROOT = Path(__file__).resolve().parent.parent
SKIP_PATHS = {
    "tools/release-acceptance",
    "tools/secret-scan",
    "tests/test_secret_scan.py",
}
SCAN_CHUNK_BYTES = 64 * 1024
SCAN_OVERLAP_BYTES = 512


def patterns() -> list[tuple[str, re.Pattern[bytes]]]:
    # Sensitive prefixes are assembled so the scanner does not match its own
    # source merely for defining the rules.
    github_prefix = b"git" + b"hub_pat_"
    private_home = b"/home/" + b"glguida"
    return [
        (
            "private key",
            re.compile(
                b"-----BEGIN (?:(?:RSA |EC |DSA |OPENSSH |ENCRYPTED )?PRIVATE KEY|"
                b"PGP PRIVATE KEY BLOCK)-----"
            ),
        ),
        ("AWS access key", re.compile(b"\\bAKIA[0-9A-Z]{16}\\b")),
        (
            "GitHub token",
            re.compile(
                b"(?:\\bgh[pousr]_[A-Za-z0-9]{36}|\\b"
                + github_prefix
                + b"[A-Za-z0-9_]{40})"
            ),
        ),
        (
            "OpenAI API key",
            re.compile(b"\\bsk-(?:proj-)?[A-Za-z0-9_-]{32}"),
        ),
        (
            "Anthropic API key",
            re.compile(b"\\bsk-ant-[A-Za-z0-9_-]{20}"),
        ),
        ("Google API key", re.compile(b"\\bAIza[0-9A-Za-z_-]{35}\\b")),
        (
            "Slack token",
            re.compile(b"\\bxox[baprs]-[0-9A-Za-z-]{20}"),
        ),
        ("private workstation path", re.compile(re.escape(private_home))),
    ]


def allowed(path: str) -> bool:
    normalized = path.removeprefix("./").replace("\\", "/")
    if normalized.startswith("graphify-out/"):
        return False
    return not any(
        normalized == skipped or normalized.endswith("/" + skipped)
        for skipped in SKIP_PATHS
    )


def stream_findings(path: str, handle: BinaryIO) -> list[str]:
    """Scan a binary stream with bounded memory and cross-chunk matching."""

    if not allowed(path):
        return []
    unresolved = patterns()
    result: list[str] = []
    tail = b""
    lines_before_tail = 0
    chunk = handle.read(SCAN_CHUNK_BYTES)
    while chunk:
        next_chunk = handle.read(SCAN_CHUNK_BYTES)
        data = tail + chunk
        searchable_end = len(data) if not next_chunk else max(
            0, len(data) - SCAN_OVERLAP_BYTES
        )
        remaining = []
        for label, pattern in unresolved:
            match = pattern.search(data)
            if match is None or match.end() > searchable_end:
                remaining.append((label, pattern))
                continue
            line = lines_before_tail + data.count(b"\n", 0, match.start()) + 1
            result.append(f"{path}:{line}: {label}")
        unresolved = remaining

        overlap = min(len(data), SCAN_OVERLAP_BYTES)
        prefix_length = len(data) - overlap
        lines_before_tail += data.count(b"\n", 0, prefix_length)
        tail = data[prefix_length:]
        chunk = next_chunk
    return result


def findings(path: str, data: bytes) -> list[str]:
    return stream_findings(path, io.BytesIO(data))


def git_output(*args: str) -> bytes:
    return subprocess.run(
        ["git", *args],
        cwd=ROOT,
        check=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
    ).stdout


def scan_history() -> list[str]:
    result: list[str] = []
    seen: set[tuple[str, str]] = set()
    commits = git_output("rev-list", "--all").decode().splitlines()
    for commit in commits:
        entries = git_output("ls-tree", "-r", "-z", "--full-tree", commit).split(b"\0")
        for entry in entries:
            if not entry:
                continue
            metadata, raw_path = entry.split(b"\t", 1)
            object_id = metadata.split()[2].decode()
            path = raw_path.decode("utf-8", "surrogateescape")
            key = (object_id, path)
            if key in seen or not allowed(path):
                continue
            seen.add(key)
            blob_findings = scan_git_blob(path, object_id)
            result.extend(f"history:{commit[:12]}:{item}" for item in blob_findings)
    return result


def scan_git_blob(path: str, object_id: str) -> list[str]:
    command = ["git", "cat-file", "blob", object_id]
    with subprocess.Popen(
        command,
        cwd=ROOT,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
    ) as process:
        assert process.stdout is not None
        assert process.stderr is not None
        result = stream_findings(path, process.stdout)
        stderr = process.stderr.read()
        returncode = process.wait()
        if returncode:
            raise subprocess.CalledProcessError(returncode, command, stderr=stderr)
    return result


def worktree_files() -> list[Path]:
    names = git_output("ls-files", "-z", "--cached", "--others", "--exclude-standard")
    return [ROOT / item.decode("utf-8", "surrogateescape") for item in names.split(b"\0") if item]


def scan_archive(path: Path) -> list[str]:
    # Always scan the container bytes as well as extracted members. Some binary
    # files happen to satisfy tar's magic checks, and archives can carry data in
    # headers or after their logical end marker.
    with path.open("rb") as handle:
        result = stream_findings(str(path), handle)
    if zipfile.is_zipfile(path):
        with zipfile.ZipFile(path) as archive:
            for member in archive.infolist():
                if member.is_dir():
                    continue
                with archive.open(member, "r") as handle:
                    result.extend(stream_findings(f"{path}:{member.filename}", handle))
        return result
    if tarfile.is_tarfile(path):
        with tarfile.open(path) as archive:
            for member in archive.getmembers():
                if not member.isfile():
                    continue
                handle = archive.extractfile(member)
                if handle is not None:
                    with handle:
                        result.extend(stream_findings(f"{path}:{member.name}", handle))
        return result
    return result


def scan_paths(paths: list[Path]) -> list[str]:
    result: list[str] = []
    for path in paths:
        if path.is_dir():
            files = sorted(item for item in path.rglob("*") if item.is_file())
        else:
            files = [path]
        for file_path in files:
            result.extend(scan_archive(file_path))
    return result


def main() -> int:
    artifact_args = [Path(argument).resolve() for argument in sys.argv[1:]]
    missing = [str(path) for path in artifact_args if not path.exists()]
    if missing:
        raise SystemExit("secret scan: missing path(s): " + ", ".join(missing))

    problems = scan_history()
    problems.extend(scan_paths(worktree_files()))
    problems.extend(scan_paths(artifact_args))
    if problems:
        print("secret scan: FAIL", file=sys.stderr)
        for problem in sorted(set(problems)):
            print(problem, file=sys.stderr)
        return 1
    print("secret scan: PASS")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
