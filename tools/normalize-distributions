#!/usr/bin/env python3
"""Canonicalize Cyclo wheel and sdist archives for reproducible releases."""

from __future__ import annotations

import copy
import gzip
import io
import os
import stat
import sys
import tarfile
import tempfile
import zipfile
from datetime import datetime, timezone
from pathlib import Path


ZIP_EPOCH = 315532800  # 1980-01-01T00:00:00Z, the earliest ZIP timestamp.
GZIP_MAX_EPOCH = (1 << 32) - 1


def fail(message: str) -> "NoReturn":
    raise SystemExit(f"normalize distributions: {message}")


def source_date_epoch() -> int:
    raw = os.environ.get("SOURCE_DATE_EPOCH")
    if raw is None:
        fail("SOURCE_DATE_EPOCH is required")
    try:
        epoch = int(raw)
    except ValueError:
        fail("SOURCE_DATE_EPOCH must be an integer")
    if not ZIP_EPOCH <= epoch <= GZIP_MAX_EPOCH:
        fail("SOURCE_DATE_EPOCH must fit the ZIP and gzip timestamp ranges")
    return epoch


def replace(path: Path, payload: bytes, epoch: int) -> None:
    mode = stat.S_IMODE(path.stat().st_mode)
    with tempfile.NamedTemporaryFile(
        dir=path.parent,
        prefix=f".{path.name}.",
        delete=False,
    ) as handle:
        temporary = Path(handle.name)
        try:
            handle.write(payload)
            handle.flush()
            os.fsync(handle.fileno())
            os.chmod(temporary, mode)
            os.replace(temporary, path)
            os.utime(path, (epoch, epoch))
        finally:
            temporary.unlink(missing_ok=True)


def normalize_sdist(path: Path, epoch: int) -> None:
    tar_payload = io.BytesIO()
    with tarfile.open(path, "r:gz") as source, tarfile.open(
        fileobj=tar_payload,
        mode="w",
        format=tarfile.PAX_FORMAT,
    ) as target:
        members = source.getmembers()
        if len({member.name for member in members}) != len(members):
            fail(f"duplicate archive member in {path.name}")
        for member in sorted(members, key=lambda item: item.name):
            normalized = copy.copy(member)
            normalized.uid = 0
            normalized.gid = 0
            normalized.uname = ""
            normalized.gname = ""
            normalized.mtime = epoch
            normalized.pax_headers = {}
            contents = source.extractfile(member) if member.isfile() else None
            target.addfile(normalized, contents)

    compressed = io.BytesIO()
    with gzip.GzipFile(
        filename="",
        mode="wb",
        compresslevel=9,
        fileobj=compressed,
        mtime=epoch,
    ) as archive:
        archive.write(tar_payload.getvalue())
    replace(path, compressed.getvalue(), epoch)


def zip_timestamp(epoch: int) -> tuple[int, int, int, int, int, int]:
    value = datetime.fromtimestamp(epoch, tz=timezone.utc)
    return value.year, value.month, value.day, value.hour, value.minute, value.second // 2 * 2


def normalize_wheel(path: Path, epoch: int) -> None:
    with zipfile.ZipFile(path, "r") as source:
        entries = source.infolist()
        if len({entry.filename for entry in entries}) != len(entries):
            fail(f"duplicate archive member in {path.name}")
        members = [(entry, source.read(entry)) for entry in entries]

    payload = io.BytesIO()
    with zipfile.ZipFile(payload, "w") as target:
        target.comment = b""
        for original, contents in sorted(members, key=lambda item: item[0].filename):
            normalized = zipfile.ZipInfo(original.filename, date_time=zip_timestamp(epoch))
            normalized.create_system = 3
            normalized.external_attr = original.external_attr
            normalized.internal_attr = original.internal_attr
            normalized.compress_type = (
                zipfile.ZIP_STORED if original.is_dir() else zipfile.ZIP_DEFLATED
            )
            target.writestr(
                normalized,
                contents,
                compress_type=normalized.compress_type,
                compresslevel=9,
            )
    replace(path, payload.getvalue(), epoch)


def main() -> int:
    if len(sys.argv) != 2:
        fail("usage: tools/normalize-distributions DIST_DIR")
    dist = Path(sys.argv[1]).resolve()
    if not dist.is_dir():
        fail(f"not a directory: {dist}")

    wheels = sorted(dist.glob("cyclo_agent-*.whl"))
    sdists = sorted(dist.glob("cyclo_agent-*.tar.gz"))
    if len(wheels) != 1 or len(sdists) != 1:
        fail("expected exactly one cyclo_agent wheel and one source distribution")

    epoch = source_date_epoch()
    normalize_wheel(wheels[0], epoch)
    normalize_sdist(sdists[0], epoch)
    print(f"normalize distributions: canonicalized wheel and sdist at {epoch}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
