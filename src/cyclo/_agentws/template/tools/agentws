class ConfinedQueueReader:
    """Read an AgentWS queue without following links below its root."""

    def __init__(self, root: Path):
        if not hasattr(os, "O_NOFOLLOW"):
            raise OSError(errno.ENOTSUP, "safe AgentWS queue reads require O_NOFOLLOW")
        self.root = Path(root).expanduser().resolve()
        flags = os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | getattr(os, "O_CLOEXEC", 0)
        self.root_fd = os.open(self.root, flags)

    def __enter__(self):
        return self

    def __exit__(self, _exc_type, _exc, _traceback):
        self.close()

    def close(self):
        if self.root_fd is not None:
            os.close(self.root_fd)
            self.root_fd = None

    @staticmethod
    def _parts(relative):
        if isinstance(relative, (str, os.PathLike)):
            path = Path(relative)
        else:
            path = Path(*relative)
        if path.is_absolute() or any(part in {"", ".", ".."} for part in path.parts):
            raise ValueError("AgentWS queue path must stay below its root")
        return path.parts

    def _open_directory(self, relative):
        parts = self._parts(relative)
        fd = os.dup(self.root_fd)
        flags = os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | getattr(os, "O_CLOEXEC", 0)
        try:
            for part in parts:
                child = os.open(part, flags, dir_fd=fd)
                os.close(fd)
                fd = child
            return fd
        except Exception:
            os.close(fd)
            raise

    def _open_parent(self, relative):
        parts = self._parts(relative)
        if not parts:
            raise ValueError("AgentWS queue file path is empty")
        return self._open_directory(parts[:-1]), parts[-1]

    def _open_regular(self, relative):
        parent_fd, name = self._open_parent(relative)
        flags = os.O_RDONLY | os.O_NONBLOCK | os.O_NOFOLLOW | getattr(os, "O_CLOEXEC", 0)
        try:
            fd = os.open(name, flags, dir_fd=parent_fd)
        finally:
            os.close(parent_fd)
        try:
            if not stat.S_ISREG(os.fstat(fd).st_mode):
                raise OSError(errno.EINVAL, "AgentWS queue entry is not a regular file")
            return fd
        except Exception:
            os.close(fd)
            raise

    def has_directory(self, relative):
        try:
            fd = self._open_directory(relative)
        except (OSError, ValueError):
            return False
        os.close(fd)
        return True

    def has_regular_file(self, relative):
        try:
            fd = self._open_regular(relative)
        except (OSError, ValueError):
            return False
        os.close(fd)
        return True

    def list_directories(self, relative, include_hidden=False):
        try:
            fd = self._open_directory(relative)
        except (OSError, ValueError):
            return []
        try:
            result = []
            for name in os.listdir(fd):
                if not include_hidden and name.startswith("."):
                    continue
                try:
                    entry = os.stat(name, dir_fd=fd, follow_symlinks=False)
                except OSError:
                    continue
                if stat.S_ISDIR(entry.st_mode):
                    result.append(name)
            return sorted(result)
        finally:
            os.close(fd)

    def list_regular_files(self, relative, suffix=""):
        try:
            fd = self._open_directory(relative)
        except (OSError, ValueError):
            return []
        try:
            result = []
            for name in os.listdir(fd):
                if suffix and not name.endswith(suffix):
                    continue
                try:
                    entry = os.stat(name, dir_fd=fd, follow_symlinks=False)
                except OSError:
                    continue
                if stat.S_ISREG(entry.st_mode):
                    result.append(name)
            return sorted(result)
        finally:
            os.close(fd)

    def directory_timestamp(self, relative):
        try:
            fd = self._open_directory(relative)
        except (OSError, ValueError):
            return None
        try:
            modified = os.fstat(fd).st_mtime
        finally:
            os.close(fd)
        return datetime.fromtimestamp(modified, timezone.utc).isoformat().replace("+00:00", "Z")

    def file_size(self, relative):
        try:
            fd = self._open_regular(relative)
        except (OSError, ValueError):
            return 0
        try:
            return os.fstat(fd).st_size
        finally:
            os.close(fd)

    def read_file(self, relative, max_bytes=256 * 1024, tail=False):
        if max_bytes < 0:
            raise ValueError("maxBytes must be non-negative")
        fd = self._open_regular(relative)
        with os.fdopen(fd, "rb", closefd=True) as stream:
            size = os.fstat(stream.fileno()).st_size
            if tail and size > max_bytes:
                stream.seek(max(0, size - max_bytes))
                data = stream.read(max_bytes)
                truncated = True
                prefix = True
            else:
                data = stream.read(max_bytes + 1)
                truncated = size > max_bytes or len(data) > max_bytes
                data = data[:max_bytes]
                prefix = False
        text = data.decode("utf-8", "replace")
        if truncated:
            marker = "\n[... earlier content truncated ...]\n" if prefix else "\n[... content truncated ...]\n"
            text = marker + text if prefix else text + marker
        return text, size, truncated

    def read_text(self, relative, fallback="", max_bytes=256 * 1024, tail=False):
        try:
            return self.read_file(relative, max_bytes=max_bytes, tail=tail)[0]
        except (OSError, ValueError):
            return fallback

    def fifo_writable(self, relative):
        try:
            parent_fd, name = self._open_parent(relative)
        except (OSError, ValueError):
            return False
        flags = os.O_WRONLY | os.O_NONBLOCK | os.O_NOFOLLOW | getattr(os, "O_CLOEXEC", 0)
        try:
            entry = os.stat(name, dir_fd=parent_fd, follow_symlinks=False)
            if not stat.S_ISFIFO(entry.st_mode):
                return False
            fd = os.open(name, flags, dir_fd=parent_fd)
            try:
                return stat.S_ISFIFO(os.fstat(fd).st_mode)
            finally:
                os.close(fd)
        except OSError:
            return False
        finally:
            os.close(parent_fd)


def write_all_nonblocking(fd: int, payload: bytes, timeout: float = FIFO_WRITE_TIMEOUT) -> None:
    deadline = time.monotonic() + timeout
    offset = 0
    while offset < len(payload):
        try:
            written = os.write(fd, payload[offset:])
        except BlockingIOError:
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                raise TimeoutError("interactive input timed out")
            select.select([], [fd], [], min(remaining, 0.1))
            continue
        if written <= 0:
            raise BrokenPipeError("interactive input pipe closed")
        offset += written


def first_markdown_title(markdown, fallback):
    match = re.search(r"^#\s+(.+)$", markdown, re.MULTILINE)
    return match.group(1).strip() if match else titleize(fallback)


def titleize(value):
    return re.sub(r"\b\w", lambda match: match.group(0).upper(), re.sub(r"[-_]+", " ", str(value or "")))


def markdown_section(markdown, heading):
    pattern = re.compile(rf"^##\s+{re.escape(heading)}\s*$([\s\S]*?)(?=^##\s+|\Z)", re.IGNORECASE | re.MULTILINE)
    match = pattern.search(markdown)
    return re.sub(r"\n{3,}", "\n\n", match.group(1).strip()) if match else ""


def first_paragraph(markdown):
    body = re.sub(r"^#.+$", "", markdown, count=1, flags=re.MULTILINE)
    for block in re.split(r"\n{2,}", body):
        block = block.strip()
        if block and not block.startswith("##"):
            return block
    return ""


def short_excerpt(value, length=280):
    clean = re.sub(r"`([^`]+)`", r"\1", str(value or ""))
    clean = re.sub(r"\s+", " ", clean).strip()
    return clean[: length - 1] + "..." if len(clean) > length else clean


def parse_events(markdown):
    events = []
    current = None
    for line in markdown.splitlines():
        match = re.match(r"^##\s+([0-9T:.-]+Z)\s+-\s+(.+)$", line)
        if match:
            if current:
                current["body"] = current["body"].strip()
                events.append(current)
            current = {"timestamp": match.group(1), "title": match.group(2).strip(), "body": ""}
        elif current:
            current["body"] += line + "\n"
    if current:
        current["body"] = current["body"].strip()
        events.append(current)
    return events


def date_value(value):
    if not value:
        return 0
    try:
        return datetime.fromisoformat(value.replace("Z", "+00:00")).timestamp()
    except ValueError:
        return 0


def duration_ms(start, end):
    a = date_value(start)
    b = date_value(end)
    return int((b - a) * 1000) if a and b and b >= a else None


def role_stage(role):
    return role.strip() or "unassigned"


def status_rank(status):
    return {"failed": 0, "running": 1, "claimed": 2, "pending": 3, "done": 4, "unknown": 5}.get(status, 6)


def read_tasks(queue: ConfinedQueueReader):
    tasks = []
    for task_id in queue.list_directories(("tasks",)):
        task_dir = ("tasks", task_id)
        state = queue.read_text(task_dir + ("state",), "open", 1024).strip() or "open"
        spec = queue.read_text(task_dir + ("spec.md",), max_bytes=160 * 1024)
        log = queue.read_text(task_dir + ("log.md",), max_bytes=512 * 1024)
        result_path = task_dir + ("result.md",)
        result = queue.read_text(result_path, max_bytes=160 * 1024)
        events = parse_events(log)
        last = events[-1] if events else None
        objective = markdown_section(spec, "Objective") or first_paragraph(spec)
        tasks.append(
            {
                "id": task_id,
                "title": first_markdown_title(spec, task_id),
                "state": state,
                "objective": short_excerpt(objective, 420),
                "specPreview": short_excerpt(spec, 520),
                "resultPreview": short_excerpt(result, 520),
                "hasResult": queue.has_regular_file(result_path),
                "eventCount": len(events),
                "events": events,
                "createdAt": (events[0]["timestamp"] if events else queue.directory_timestamp(task_dir)),
                "updatedAt": (last["timestamp"] if last else queue.directory_timestamp(task_dir)),
            }
        )
    return tasks


def read_jobs(queue: ConfinedQueueReader):
    jobs = []
    for job_id in queue.list_directories(("jobs",)):
        job_dir = ("jobs", job_id)
        status = queue.read_text(job_dir + ("status",), "unknown", 1024).strip() or "unknown"
        task_id = queue.read_text(job_dir + ("task-id",), max_bytes=1024).strip()
        role = queue.read_text(job_dir + ("role",), max_bytes=1024).strip()
        agent_id = queue.read_text(job_dir + ("agent-id",), max_bytes=1024).strip()
        spec = queue.read_text(job_dir + ("spec.md",), max_bytes=160 * 1024)
        log = queue.read_text(job_dir + ("log.md",), max_bytes=512 * 1024)
        events = parse_events(log)
        first = events[0] if events else None
        last = events[-1] if events else None
        last_text = f"{last.get('title', '') if last else ''} {last.get('body', '') if last else ''}"
        log_size = queue.file_size(job_dir + ("log.md",))
        jobs.append(
            {
                "id": job_id,
                "title": titleize(job_id),
                "status": status,
                "taskId": task_id,
                "role": role,
                "agentId": agent_id,
                "stage": role_stage(role),
                "eventCount": len(events),
                "events": events,
                "firstEventAt": first["timestamp"] if first else None,
                "updatedAt": last["timestamp"] if last else queue.directory_timestamp(job_dir),
                "durationMs": duration_ms(first["timestamp"] if first else None, last["timestamp"] if last else None),
                "specPreview": short_excerpt(spec, 420),
                "latestSummary": short_excerpt((last or {}).get("body") or (last or {}).get("title") or spec, 360),
                "attention": status == "failed" or bool(re.search(r"blocked|error|failed|superseded", last_text, re.IGNORECASE)),
                "logSize": log_size,
            }
        )
    return sorted(jobs, key=lambda job: (status_rank(job["status"]), -date_value(job["updatedAt"]), job["id"]))


def list_agent_sessions(queue: ConfinedQueueReader, agent_id: str):
    return queue.list_regular_files(("agents", agent_id, "pi-session"), suffix=".jsonl")


def read_agents(queue: ConfinedQueueReader, jobs_by_agent):
    agents = []
    team_runs = ("agents", ".team-runs")
    for agent_id in queue.list_directories(("agents",)):
        agent_dir = ("agents", agent_id)
        jobs = jobs_by_agent.get(agent_id, [])
        active_jobs = [job for job in jobs if job["status"] in {"claimed", "running"}]
        interactive = queue.has_regular_file(agent_dir + ("interactive",))
        input_ready = queue.fifo_writable(agent_dir + ("input.fifo",))
        agents.append(
            {
                "id": agent_id,
                "name": queue.read_text(agent_dir + ("name",), agent_id, 2048).strip() or agent_id,
                "role": queue.read_text(agent_dir + ("role",), max_bytes=2048).strip(),
                "engine": queue.read_text(agent_dir + ("engine",), max_bytes=2048).strip(),
                "createdAt": queue.read_text(agent_dir + ("created_at",), max_bytes=2048).strip(),
                "lastStartedAt": queue.read_text(agent_dir + ("last_started_at",), max_bytes=2048).strip(),
                "currentJob": queue.read_text(agent_dir + ("current-job",), max_bytes=2048).strip(),
                "active": bool(active_jobs) or (interactive and input_ready),
                "activeJobIds": [job["id"] for job in active_jobs],
                "jobCount": len(jobs),
                "doneJobs": len([job for job in jobs if job["status"] == "done"]),
                "failedJobs": len([job for job in jobs if job["status"] == "failed"]),
                "transcriptSize": queue.file_size(agent_dir + ("transcript.log",)),
                "errorSize": queue.file_size(agent_dir + ("error.log",)),
                "sessionCount": len(list_agent_sessions(queue, agent_id)),
                "promptPreview": short_excerpt(queue.read_text(agent_dir + ("prompt.md",), max_bytes=80 * 1024), 420),
                "runnerStatus": queue.read_text(team_runs + (f"{agent_id}.last-status",), max_bytes=2048).strip(),
                "runnerExit": queue.read_text(team_runs + (f"{agent_id}.last-exit",), max_bytes=2048).strip(),
                "interactive": interactive,
                "inputReady": input_ready,
                "busy": input_ready and queue.read_text(agent_dir + ("busy",), max_bytes=64).strip() == "1",
            }
        )
    return sorted(agents, key=lambda agent: (agent["role"], agent["id"]))


def is_fifo(path: Path):
    try:
        return stat.S_ISFIFO(path.stat().st_mode)
    except OSError:
        return False


def enrich_tasks(tasks, jobs):
    by_task = {}
    for job in jobs:
        by_task.setdefault(job["taskId"], []).append(job)

    for task in tasks:
        task_jobs = sorted(
            by_task.get(task["id"], []),
            key=lambda job: (date_value(job.get("firstEventAt") or job.get("updatedAt")), job["id"]),
        )
        cycle_start = task_reopen_timestamp(task)
        flow_jobs = [job for job in task_jobs if not cycle_start or date_value(job.get("updatedAt")) >= cycle_start]
        done = len([job for job in task_jobs if job["status"] == "done"])
        failed = len([job for job in flow_jobs if job["status"] == "failed"])
        running = len([job for job in flow_jobs if job["status"] in {"running", "claimed"}])
        pending = len([job for job in flow_jobs if job["status"] == "pending"])
        attention = failed > 0 or any(job["attention"] for job in flow_jobs)
        task["jobs"] = [job["id"] for job in task_jobs]
        task["jobCount"] = len(task_jobs)
        task["doneJobs"] = done
        task["failedJobs"] = failed
        task["runningJobs"] = running
        task["pendingJobs"] = pending
        task["roles"] = sorted({job["role"] for job in task_jobs if job["role"]})
        task["agents"] = sorted({job["agentId"] for job in task_jobs if job["agentId"]})
        task["flowState"] = infer_task_flow_state(task, flow_jobs, attention)
        task["progress"] = 100 if task["flowState"] == "closed" else round((done / len(task_jobs)) * 100) if task_jobs else 0
        task["latestJob"] = max(task_jobs, key=lambda job: date_value(job.get("updatedAt")), default={}).get("id", "")
        timestamps = [task.get("updatedAt")] + [job.get("updatedAt") for job in task_jobs]
        task["updatedAt"] = max((value for value in timestamps if value), key=date_value, default=task.get("updatedAt"))
    return sorted(tasks, key=lambda task: (-date_value(task.get("updatedAt")), task["id"]))


def infer_task_flow_state(task, jobs, attention):
    if is_task_closed(task):
        return "closed"
    if attention:
        return "blocked"
    if any(job["status"] in {"running", "claimed"} for job in jobs):
        return "active"
    if any(job["status"] == "pending" for job in jobs):
        return "pending"
    if jobs:
        return "pending"
    return "intake"


def is_task_closed(task):
    state = task.get("state", "open")
    if state and state != "open":
        return True

    latest_reopen = task_reopen_timestamp(task)
    latest_result = task_result_timestamp(task)
    if latest_reopen and latest_reopen >= latest_result:
        return False

    return task["hasResult"] or bool(latest_result)


def task_result_timestamp(task):
    return max(
        (date_value(event["timestamp"]) for event in task["events"] if re.search(r"result recorded", event["title"], re.IGNORECASE)),
        default=0,
    )


def task_reopen_timestamp(task):
    latest_result = task_result_timestamp(task)
    latest_reopen = max(
        (
            date_value(event["timestamp"])
            for event in task["events"]
            if re.search(r"\bstate:\s*open\b", f"{event['title']} {event['body']}", re.IGNORECASE)
        ),
        default=0,
    )
    return latest_reopen if latest_reopen and latest_reopen >= latest_result else 0


def build_activity(tasks, jobs):
    activity = []
    for task in tasks:
        for index, event in enumerate(task["events"]):
            activity.append(
                {
                    "id": f"task:{task['id']}:{index}",
                    "type": "task",
                    "itemId": task["id"],
                    "taskId": task["id"],
                    "timestamp": event["timestamp"],
                    "title": event["title"],
                    "body": short_excerpt(event["body"], 360),
                    "status": task["flowState"],
                }
            )
    for job in jobs:
        for index, event in enumerate(job["events"]):
            activity.append(
                {
                    "id": f"job:{job['id']}:{index}",
                    "type": "job",
                    "itemId": job["id"],
                    "taskId": job["taskId"],
                    "timestamp": event["timestamp"],
                    "title": event["title"],
                    "body": short_excerpt(event["body"], 360),
                    "status": job["status"],
                    "role": job["role"],
                    "agentId": job["agentId"],
                }
            )
    return sorted([event for event in activity if event["timestamp"]], key=lambda event: -date_value(event["timestamp"]))[:160]


def build_metrics(tasks, jobs, agents):
    return {
        "tasksTotal": len(tasks),
        "tasksByFlow": count_by(tasks, "flowState"),
        "jobsTotal": len(jobs),
        "jobsByStatus": count_by(jobs, "status"),
        "agentsTotal": len(agents),
        "activeAgents": len([agent for agent in agents if agent["active"]]),
        "failedJobs": len([job for job in jobs if job["status"] == "failed"]),
        "attentionTasks": len([task for task in tasks if task["flowState"] == "blocked"]),
    }


def count_by(items, field):
    result = {}
    for item in items:
        key = item.get(field) or "unknown"
        result[key] = result.get(key, 0) + 1
    return result


def build_snapshot(root: Path):
    root = root.resolve()
    with ConfinedQueueReader(root) as queue:
        missing = [name for name in ("tasks", "jobs", "agents") if not queue.has_directory((name,))]
        if missing:
            raise ValueError(f"AgentWS root is missing {', '.join(missing)}: {root}")

        tasks_raw = read_tasks(queue)
        jobs = read_jobs(queue)
        jobs_by_agent = {}
        for job in jobs:
            if job["agentId"]:
                jobs_by_agent.setdefault(job["agentId"], []).append(job)
        agents = read_agents(queue, jobs_by_agent)
        tasks = enrich_tasks(tasks_raw, jobs)
    return {
        "root": str(root),
        "generatedAt": utc_now(),
        "tasks": tasks,
        "jobs": jobs,
        "agents": agents,
        "activity": build_activity(tasks, jobs),
        "metrics": build_metrics(tasks, jobs, agents),
    }


class ViewerHandler(BaseHTTPRequestHandler):
    config: Config

    def log_message(self, fmt, *args):
        sys.stderr.write("%s - %s\n" % (self.address_string(), fmt % args))

    def do_GET(self):
        parsed = urlparse(self.path)
        if parsed.path.startswith("/api/"):
            self.handle_api(parsed)
        else:
            self.serve_static(parsed.path)

    def do_POST(self):
        parsed = urlparse(self.path)
        if parsed.path.startswith("/api/"):
            self.handle_api_post(parsed)
        else:
            self.send_json(404, {"error": "unknown route"})

    def handle_api(self, parsed):
        query = parse_qs(parsed.query)
        root = self.resolve_api_root(query)
        try:
            if parsed.path == "/api/snapshot":
                snapshot = build_snapshot(root)
                snapshot["capabilities"] = {"agentInput": not self.config.read_only}
                self.send_json(200, snapshot)
            elif parsed.path == "/api/file":
                self.handle_file(root, query)
            else:
                self.send_json(404, {"error": "unknown api route"})
        except Exception as exc:
            self.send_json(400, {"error": str(exc)})

    def handle_api_post(self, parsed):
        query = parse_qs(parsed.query)
        root = self.resolve_api_root(query)
        try:
            if parsed.path == "/api/agent-input":
                if self.config.read_only:
                    self.send_json(403, {"error": "viewer is read-only"})
                else:
                    self.handle_agent_input(root, query)
            else:
                self.send_json(404, {"error": "unknown api route"})
        except Exception as exc:
            self.send_json(400, {"error": str(exc)})

    def resolve_api_root(self, query):
        if self.config.pin_root:
            return self.config.root
        root_value = query.get("root", [str(self.config.root)])[0] or str(self.config.root)
        return Path(root_value).expanduser()

    def handle_file(self, root: Path, query):
        item_type = query.get("type", [""])[0]
        item_id = query.get("id", [""])[0]
        filename = query.get("file", [""])[0]
        if item_type not in TYPE_DIR:
            raise ValueError("invalid type")
        if not VALID_ID.match(item_id):
            raise ValueError("invalid id")
        if filename not in ALLOWED_FILES[item_type]:
            raise ValueError("invalid file")

        max_bytes = int(query.get("maxBytes", ["524288"])[0] or 524288)
        if max_bytes < 0:
            raise ValueError("maxBytes must be non-negative")
        max_bytes = min(max_bytes, 2 * 1024 * 1024)
        tail = query.get("tail", ["0"])[0] == "1"
        relative = (TYPE_DIR[item_type], item_id, filename)
        path = root.resolve() / Path(*relative)
        try:
            with ConfinedQueueReader(root) as queue:
                text, size, truncated = queue.read_file(relative, max_bytes=max_bytes, tail=tail)
        except (OSError, ValueError):
            self.send_json(404, {"error": "file not found"})
            return
        self.send_json(
            200,
            {
                "type": item_type,
                "id": item_id,
                "file": filename,
                "path": str(path),
                "size": size,
                "truncated": truncated,
                "text": text,
            },
        )

    def handle_agent_input(self, root: Path, query):
        agent_id = query.get("id", [""])[0]
        if not VALID_ID.match(agent_id):
            raise ValueError("invalid agent id")

        length = min(int(self.headers.get("Content-Length", "0") or "0"), 64 * 1024)
        payload = json.loads(self.rfile.read(length).decode("utf-8") or "{}")
        message = str(payload.get("message") or "").strip()
        mode = str(payload.get("mode") or "follow_up")
        if not message:
            raise ValueError("message is required")
        if mode not in {"follow_up", "steer", "prompt"}:
            raise ValueError("invalid mode")

        agent_dir = root.resolve() / "agents" / agent_id
        if not (agent_dir / "interactive").is_file():
            self.send_json(409, {"error": "agent is not interactive"})
            return
        input_fifo = agent_dir / "input.fifo"
        if not is_fifo(input_fifo):
            self.send_json(409, {"error": "interactive input is not ready"})
            return

        line = json.dumps({"message": message, "mode": mode}) + "\n"
        try:
            fd = os.open(input_fifo, os.O_WRONLY | os.O_NONBLOCK)
        except OSError as exc:
            if exc.errno == errno.ENXIO:
                self.send_json(409, {"error": "interactive agent is not listening; restart AgentWS or wait for the console to finish starting"})
                return
            self.send_json(409, {"error": f"interactive input is not available: {exc.strerror}"})
            return
        try:
            write_all_nonblocking(fd, line.encode("utf-8"))
        except TimeoutError as exc:
            self.send_json(409, {"error": str(exc)})
            return
        except OSError as exc:
            self.send_json(409, {"error": f"interactive input write failed: {exc.strerror or exc}"})
            return
        finally:
            os.close(fd)
        self.send_json(200, {"ok": True})

    def serve_static(self, raw_path):
        relative = unquote(raw_path.lstrip("/")) or "index.html"
        if relative == "":
            relative = "index.html"
        requested = (PUBLIC_DIR / relative).resolve()
        try:
            requested.relative_to(PUBLIC_DIR.resolve())
        except ValueError:
            self.send_error(403)
            return
        if not requested.is_file():
            requested = PUBLIC_DIR / "index.html"
        content_type = mimetypes.guess_type(str(requested))[0] or "application/octet-stream"
        payload = requested.read_bytes()
        self.send_response(200)
        self.send_header("Content-Type", content_type)
        self.send_header("Content-Length", str(len(payload)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(payload)

    def send_json(self, status, payload):
        body = json.dumps(payload).encode("utf-8")
        self.send_response(status)
        self.send_header("Content-Type", "application/json; charset=utf-8")
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(body)


def start_team(root: Path, team: TeamDefinition, workspace: Path, verbose: bool):
    runner = root / "tools" / "run_agentws"
    if not runner.is_file():
        raise ValueError(f"AgentWS runner not found: {runner}")

    command = [str(runner)]
    if verbose:
        command.append("--verbose")

    proc = subprocess.Popen(
        command,
        cwd=root,
        env=team_environment(team, workspace),
        start_new_session=True,
    )
    time.sleep(0.2)
    rc = proc.poll()
    if rc is not None:
        raise RuntimeError(f"AgentWS team exited early with status {rc}")
    return proc


def start_console(
    root: Path,
    team: TeamDefinition,
    workspace: Path,
    model: str | None,
    verbose: bool,
):
    console = root / "tools" / "agent-pi-interactive"
    if not console.is_file():
        raise ValueError(f"AgentWS console runner not found: {console}")

    command = [str(console), "--console"]
    if not verbose:
        command.append("--headless")
    if model:
        command.extend(["--model", model])

    proc = subprocess.Popen(
        command,
        cwd=root,
        env=team_environment(team, workspace),
        start_new_session=True,
    )
    time.sleep(0.2)
    rc = proc.poll()
    if rc is not None:
        raise RuntimeError(f"AgentWS console exited early with status {rc}")
    return proc


def stop_team(proc):
    if proc is None:
        return
    # The leader may already be gone while child agents remain in its process group.
    running = proc.poll() is None
    try:
        os.killpg(proc.pid, signal.SIGTERM)
    except ProcessLookupError:
        return
    if not running:
        return
    try:
        proc.wait(timeout=5)
    except subprocess.TimeoutExpired:
        os.killpg(proc.pid, signal.SIGKILL)
        proc.wait(timeout=5)


class ProcessSupervisor:
    def __init__(
        self,
        label,
        starter,
        check_interval=PROCESS_CHECK_INTERVAL,
        restart_delay=PROCESS_RESTART_DELAY,
    ):
        self.label = label
        self.starter = starter
        self.check_interval = check_interval
        self.restart_delay = restart_delay
        self.stop_event = threading.Event()
        self.lock = threading.Lock()
        self.proc = None
        self.thread = None

    def start(self):
        proc = self.starter()
        with self.lock:
            self.proc = proc
        print(f"AgentWS {self.label} started pid={proc.pid}")
        self.thread = threading.Thread(
            target=self.watch,
            name=f"agentws-{self.label}-supervisor",
            daemon=True,
        )
        self.thread.start()

    def current_proc(self):
        with self.lock:
            return self.proc

    def set_proc(self, proc):
        with self.lock:
            self.proc = proc

    def watch(self):
        while not self.stop_event.wait(self.check_interval):
            proc = self.current_proc()
            if proc is None:
                continue
            rc = proc.poll()
            if rc is None:
                continue

            self.set_proc(None)
            if self.stop_event.is_set():
                return
            print(f"AgentWS {self.label} exited with status {rc}; restarting.", file=sys.stderr)
            stop_team(proc)
            self.restart()

    def restart(self):
        while not self.stop_event.is_set():
            try:
                proc = self.starter()
            except (OSError, RuntimeError, ValueError) as exc:
                print(f"error: failed to restart AgentWS {self.label}: {exc}", file=sys.stderr)
                self.stop_event.wait(self.restart_delay)
                continue

            if self.stop_event.is_set():
                stop_team(proc)
                return

            self.set_proc(proc)
            print(f"AgentWS {self.label} restarted pid={proc.pid}")
            return

    def stop(self):
        self.stop_event.set()
        proc = self.current_proc()
        self.set_proc(None)
        stop_team(proc)
        if self.thread is not None and self.thread.is_alive():
            self.thread.join(timeout=self.check_interval + self.restart_delay + 1)


def main():
    parser = argparse.ArgumentParser(description="AgentWS runner and local web interface")
    parser.add_argument("--root", default=os.environ.get("AGENTWS_ROOT", str(DEFAULT_ROOT)), help="AgentWS root directory")
    parser.add_argument(
        "--workspace",
        help="agent process working directory (default: the AgentWS runtime root)",
    )
    parser.add_argument("--host", default=os.environ.get("HOST", "127.0.0.1"), help="Bind host (default: 127.0.0.1)")
    default_port = int(os.environ["PORT"]) if "PORT" in os.environ else DEFAULT_PORT
    parser.add_argument(
        "--port",
        default=default_port,
        type=int,
        help=f"Bind starting port (default: first free port at or above {DEFAULT_PORT})",
    )
    parser.add_argument("--no-team", action="store_true", help="serve the web interface without starting agents")
    parser.add_argument("--no-console", action="store_true", help="do not start the built-in console agent")
    parser.add_argument("--console-model", help="model to pass to the built-in console agent")
    parser.add_argument(
        "--pin-root",
        action="store_true",
        help="pin API requests to --root and ignore root query overrides",
    )
    parser.add_argument(
        "--read-only",
        action="store_true",
        help="disable interactive agent input through the web interface",
    )
    parser.add_argument(
        "--team-manifest",
        help="portable team manifest; paths inside it are relative to the manifest directory",
    )
    parser.add_argument("--verbose", action="store_true", help="print agent transcript output in this terminal")
    parser.add_argument("team_file", nargs="?", help="team file to run; defaults to agentws/default.team")
    args = parser.parse_args()

    config = Config(
        root=Path(args.root).expanduser().resolve(),
        host=args.host,
        port=args.port,
        pin_root=args.pin_root,
        read_only=args.read_only,
    )
    workspace = Path(args.workspace).expanduser().resolve() if args.workspace else config.root
    if not workspace.is_dir():
        print(f"error: AgentWS workspace directory not found: {workspace}", file=sys.stderr)
        return 1
    if args.team_manifest and args.team_file:
        parser.error("team_file cannot be used together with --team-manifest")
    try:
        team = (
            load_team_manifest(Path(args.team_manifest))
            if args.team_manifest
            else legacy_team_definition(config.root, args.team_file)
        )
    except ValueError as exc:
        print(f"error: {exc}", file=sys.stderr)
        return 1
    ViewerHandler.config = config

    supervisors = []
    server = bind_server(config)
    if server is None:
        return 1

    def request_stop(_signum, _frame):
        raise KeyboardInterrupt

    signal.signal(signal.SIGTERM, request_stop)

    try:
        if not args.no_team:
            if not args.no_console:
                console_supervisor = ProcessSupervisor(
                    "console",
                    lambda: start_console(
                        config.root,
                        team,
                        workspace,
                        args.console_model,
                        args.verbose,
                    ),
                )
                console_supervisor.start()
                supervisors.append(console_supervisor)
            team_supervisor = ProcessSupervisor(
                "team",
                lambda: start_team(config.root, team, workspace, args.verbose),
            )
            team_supervisor.start()
            supervisors.append(team_supervisor)

        print(f"AgentWS running at {server_url(server, config)}")
        print(f"Reading AgentWS root: {config.root}")
        server.serve_forever()
        return 0
    except KeyboardInterrupt:
        print("\nStopping.")
        return 0
    except (RuntimeError, ValueError) as exc:
        print(f"error: {exc}", file=sys.stderr)
        return 1
    finally:
        server.server_close()
        for supervisor in reversed(supervisors):
            supervisor.stop()


if __name__ == "__main__":
    raise SystemExit(main())
