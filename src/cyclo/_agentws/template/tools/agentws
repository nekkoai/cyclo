@dataclass(frozen=True)
class TeamDefinition:
    root: Path
    roster: Path
    protocol: Path
    roles_dir: Path
    console_role: str
    manifest: Path | None = None


class DuplicateManifestKey(ValueError):
    pass


def _manifest_object(pairs):
    result = {}
    for key, value in pairs:
        if key in result:
            raise DuplicateManifestKey(f"duplicate field '{key}'")
        result[key] = value
    return result


def _require_manifest_string(data, key, manifest):
    value = data.get(key)
    if not isinstance(value, str) or not value.strip():
        raise ValueError(f"team manifest {manifest}: '{key}' must be a non-empty string")
    return value


def _confined_team_path(team_root: Path, value: str, label: str, manifest: Path):
    relative = Path(value)
    if relative.is_absolute():
        raise ValueError(f"team manifest {manifest}: '{label}' must be relative to the team repository")
    resolved = (team_root / relative).resolve()
    try:
        resolved.relative_to(team_root)
    except ValueError as exc:
        raise ValueError(f"team manifest {manifest}: '{label}' must stay within the team repository") from exc
    return resolved


def _validate_team_role(role: str, label: str, manifest: Path):
    if not VALID_ID.match(role):
        raise ValueError(
            f"team manifest {manifest}: invalid {label} '{role}' - "
            "only alphanumeric, dot, underscore, and hyphen allowed"
        )


def _validate_roster(roster: Path, roles_dir: Path, team_root: Path, manifest: Path):
    seen_names = set()
    entry_count = 0
    try:
        lines = roster.read_text(encoding="utf-8").splitlines()
    except (OSError, UnicodeError) as exc:
        raise ValueError(f"team manifest {manifest}: cannot read roster {roster}: {exc}") from exc

    for line_no, line in enumerate(lines, 1):
        stripped = line.strip()
        if not stripped or stripped.startswith("#"):
            continue
        fields = stripped.split()
        if len(fields) not in (3, 4):
            raise ValueError(
                f"team manifest {manifest}: {roster}:{line_no}: "
                "expected <name> <role> <agent> [model]"
            )
        name, role, engine = fields[:3]
        _validate_team_role(name, "agent name", manifest)
        _validate_team_role(role, "role", manifest)
        if name in seen_names:
            raise ValueError(f"team manifest {manifest}: duplicate agent name '{name}' in {roster}")
        if engine not in VALID_TEAM_ENGINES:
            raise ValueError(
                f"team manifest {manifest}: invalid agent '{engine}' in {roster}:{line_no}; "
                "expected pi, pi-interactive, codex, or claude"
            )

        role_file = (roles_dir / f"{role}.md").resolve()
        try:
            role_file.relative_to(team_root)
        except ValueError as exc:
            raise ValueError(
                f"team manifest {manifest}: role file for '{role}' must stay within the team repository"
            ) from exc
        if not role_file.is_file():
            raise ValueError(f"team manifest {manifest}: role file not found for '{role}': {role_file}")
        seen_names.add(name)
        entry_count += 1

    if entry_count == 0:
        raise ValueError(f"team manifest {manifest}: roster has no agents: {roster}")


def load_team_manifest(path: Path):
    manifest = path.expanduser().resolve()
    if not manifest.is_file():
        raise ValueError(f"team manifest not found: {manifest}")
    try:
        data = json.loads(
            manifest.read_text(encoding="utf-8"),
            object_pairs_hook=_manifest_object,
        )
    except (OSError, UnicodeError, json.JSONDecodeError, DuplicateManifestKey) as exc:
        raise ValueError(f"cannot read team manifest {manifest}: {exc}") from exc
    if not isinstance(data, dict):
        raise ValueError(f"team manifest {manifest}: top level must be an object")

    expected = {"schema", "roster", "protocol", "roles_dir", "console"}
    missing = sorted(expected - set(data))
    unknown = sorted(set(data) - expected)
    if missing:
        raise ValueError(f"team manifest {manifest}: missing fields: {', '.join(missing)}")
    if unknown:
        raise ValueError(f"team manifest {manifest}: unknown fields: {', '.join(unknown)}")
    if type(data["schema"]) is not int or data["schema"] != 1:
        raise ValueError(f"team manifest {manifest}: 'schema' must be integer 1")

    console = data["console"]
    if not isinstance(console, dict) or set(console) != {"role"}:
        raise ValueError(f"team manifest {manifest}: 'console' must contain exactly one 'role' field")
    console_role = console.get("role")
    if not isinstance(console_role, str) or not console_role:
        raise ValueError(f"team manifest {manifest}: 'console.role' must be a non-empty string")
    _validate_team_role(console_role, "console role", manifest)

    team_root = manifest.parent.resolve()
    roster = _confined_team_path(
        team_root,
        _require_manifest_string(data, "roster", manifest),
        "roster",
        manifest,
    )
    protocol = _confined_team_path(
        team_root,
        _require_manifest_string(data, "protocol", manifest),
        "protocol",
        manifest,
    )
    roles_dir = _confined_team_path(
        team_root,
        _require_manifest_string(data, "roles_dir", manifest),
        "roles_dir",
        manifest,
    )

    if not roster.is_file():
        raise ValueError(f"team manifest {manifest}: roster file not found: {roster}")
    if not protocol.is_file():
        raise ValueError(f"team manifest {manifest}: protocol file not found: {protocol}")
    if not roles_dir.is_dir():
        raise ValueError(f"team manifest {manifest}: roles directory not found: {roles_dir}")

    console_file = (roles_dir / f"{console_role}.md").resolve()
    try:
        console_file.relative_to(team_root)
    except ValueError as exc:
        raise ValueError(
            f"team manifest {manifest}: console role file must stay within the team repository"
        ) from exc
    if not console_file.is_file():
        raise ValueError(f"team manifest {manifest}: console role file not found: {console_file}")

    _validate_roster(roster, roles_dir, team_root, manifest)
    return TeamDefinition(
        root=team_root,
        roster=roster,
        protocol=protocol,
        roles_dir=roles_dir,
        console_role=console_role,
        manifest=manifest,
    )


def legacy_team_definition(root: Path, team_file=None):
    root = root.resolve()
    roster = Path(team_file).expanduser() if team_file else root / "default.team"
    if not roster.is_absolute():
        roster = root / roster
    return TeamDefinition(
        root=root,
        roster=roster.resolve(),
        protocol=(root / "AGENTS.md").resolve(),
        roles_dir=(root / "roles").resolve(),
        console_role="console",
    )


def team_environment(team: TeamDefinition, workspace: Path):
    env = os.environ.copy()
    env.update(
        {
            "AGENTWS_TEAM_ROOT": str(team.root),
            "AGENTWS_TEAM_ROSTER": str(team.roster),
            "AGENTWS_TEAM_PROTOCOL": str(team.protocol),
            "AGENTWS_TEAM_ROLES_DIR": str(team.roles_dir),
            "AGENTWS_TEAM_CONSOLE_ROLE": team.console_role,
            "AGENTWS_WORKSPACE": str(workspace),
        }
    )
    return env


class AgentWSServer(ThreadingHTTPServer):
    allow_reuse_address = True


def bind_server(config: Config):
    attempts = 100 if config.port else 1
    last_error = None
    for offset in range(attempts):
        port = config.port + offset if config.port else 0
        try:
            server = AgentWSServer((config.host, port), ViewerHandler)
            if offset:
                print(f"AgentWS port {config.port} was busy; using {port}.", file=sys.stderr)
            return server
        except OSError as exc:
            last_error = exc
            if exc.errno == errno.EADDRINUSE and offset + 1 < attempts:
                continue
            break

    exc = last_error
    url = f"http://{config.host}:{config.port}"
    reason = exc.strerror if exc and exc.strerror else str(exc)
    print(f"error: cannot start AgentWS web interface at {url}: {reason}", file=sys.stderr)
    if exc and exc.errno == errno.EADDRINUSE:
        end_port = config.port + attempts - 1
        print(f"hint: tried ports {config.port}-{end_port}; stop the listener or pass --port <port>.", file=sys.stderr)
    elif exc and exc.errno in (errno.EACCES, errno.EPERM):
        print("hint: permission denied while binding; use the default 127.0.0.1 host or choose another port.", file=sys.stderr)
    elif exc and exc.errno == errno.EADDRNOTAVAIL:
        print("hint: the requested host is not available on this machine; try --host 127.0.0.1.", file=sys.stderr)
    return None


def server_url(server, config: Config):
    host = config.host
    if host in ("", "0.0.0.0", "::"):
        host = "127.0.0.1"
    if ":" in host and not host.startswith("["):
        host = f"[{host}]"
    return f"http://{host}:{server.server_address[1]}"


