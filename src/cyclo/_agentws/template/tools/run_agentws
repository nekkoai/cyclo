#!/bin/sh
# SPDX-License-Identifier: MIT
set -eu

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
AGENTWS_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
RUN_DIR="$AGENTWS_ROOT/agents/.team-runs"

. "$AGENTWS_ROOT/bin/lib-agentws"

usage() {
    cat <<'EOF'
Usage: tools/run_agentws [--verbose] [team-file]

Run the named AgentWS team. Team file format:

  <name> <role> <agent> [model]

If team-file is omitted, AGENTWS_TEAM_ROSTER is used when set, otherwise
agentws/default.team. Portable team paths are passed through AGENTWS_TEAM_*
environment variables. Blank lines and # comments are ignored. Agent is one
of: pi, pi-interactive, codex, claude.

Options:
  --verbose   Print each agent's rendered transcript output to this terminal.

Retry safety is configured with AGENTWS_MAX_JOB_ATTEMPTS,
AGENTWS_MAX_CONSECUTIVE_FAILURES, AGENTWS_RETRY_INITIAL_SECONDS, and
AGENTWS_RETRY_MAX_SECONDS.
EOF
}

agent_flag() {
    case "$1" in
        pi) echo "--pi" ;;
        codex) echo "--codex" ;;
        claude) echo "--claude" ;;
        *) die "invalid agent '$1' in team file; expected pi, pi-interactive, codex, or claude" ;;
    esac
}

run_agent_once() {
    headless_arg="$1"
    agent="$2"
    model="$3"
    role="$4"
    name="$5"

    if [ "$agent" = "pi-interactive" ]; then
        if [ -n "$model" ]; then
            "$SCRIPT_DIR/agent-pi-interactive" $headless_arg -m "$model" "$role" "$name"
        else
            "$SCRIPT_DIR/agent-pi-interactive" $headless_arg "$role" "$name"
        fi
        return
    fi

    flag="$(agent_flag "$agent")"
    if [ -n "$model" ]; then
        "$SCRIPT_DIR/agent" $headless_arg "$flag" -m "$model" "$role" "$name"
    else
        "$SCRIPT_DIR/agent" $headless_arg "$flag" "$role" "$name"
    fi
}

VERBOSE=0

while [ "$#" -gt 0 ]; do
    case "$1" in
        --verbose)
            VERBOSE=1
            shift
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        -*)
            usage >&2
            exit 1
            ;;
        *)
            break
            ;;
    esac
done

[ "$#" -le 1 ] || {
    usage >&2
    exit 1
}

TEAM_ROOT="${AGENTWS_TEAM_ROOT:-$AGENTWS_ROOT}"
TEAM_FILE="${1:-${AGENTWS_TEAM_ROSTER:-$TEAM_ROOT/default.team}}"
PROTOCOL_FILE="${AGENTWS_TEAM_PROTOCOL:-$TEAM_ROOT/AGENTS.md}"
ROLES_DIR="${AGENTWS_TEAM_ROLES_DIR:-$TEAM_ROOT/roles}"
CONSOLE_ROLE="${AGENTWS_TEAM_CONSOLE_ROLE:-console}"
WORKSPACE="${AGENTWS_WORKSPACE:-$AGENTWS_ROOT}"
MAX_JOB_ATTEMPTS="${AGENTWS_MAX_JOB_ATTEMPTS:-3}"
MAX_CONSECUTIVE_FAILURES="${AGENTWS_MAX_CONSECUTIVE_FAILURES:-5}"
RETRY_INITIAL_SECONDS="${AGENTWS_RETRY_INITIAL_SECONDS:-2}"
RETRY_MAX_SECONDS="${AGENTWS_RETRY_MAX_SECONDS:-30}"
FATAL_AGENT_EXIT=70
case "$TEAM_FILE" in
    */*) ;;
    *) TEAM_FILE="$AGENTWS_ROOT/$TEAM_FILE" ;;
esac

[ -f "$TEAM_FILE" ] || die "team file not found: $TEAM_FILE"
[ -f "$PROTOCOL_FILE" ] || die "team protocol not found: $PROTOCOL_FILE"
[ -d "$ROLES_DIR" ] || die "team roles directory not found: $ROLES_DIR"
[ -d "$WORKSPACE" ] || die "agent workspace directory not found: $WORKSPACE"
require_positive_integer "AGENTWS_MAX_JOB_ATTEMPTS" "$MAX_JOB_ATTEMPTS"
require_positive_integer "AGENTWS_MAX_CONSECUTIVE_FAILURES" "$MAX_CONSECUTIVE_FAILURES"
require_positive_integer "AGENTWS_RETRY_INITIAL_SECONDS" "$RETRY_INITIAL_SECONDS"
require_positive_integer "AGENTWS_RETRY_MAX_SECONDS" "$RETRY_MAX_SECONDS"
[ "$MAX_JOB_ATTEMPTS" -le 100 ] \
    || die "AGENTWS_MAX_JOB_ATTEMPTS must not exceed 100"
[ "$MAX_CONSECUTIVE_FAILURES" -le 100 ] \
    || die "AGENTWS_MAX_CONSECUTIVE_FAILURES must not exceed 100"
[ "$RETRY_INITIAL_SECONDS" -le "$RETRY_MAX_SECONDS" ] \
    || die "AGENTWS_RETRY_INITIAL_SECONDS must not exceed AGENTWS_RETRY_MAX_SECONDS"
[ "$RETRY_MAX_SECONDS" -le 3600 ] \
    || die "AGENTWS_RETRY_MAX_SECONDS must not exceed 3600"

export AGENTWS_TEAM_ROOT="$TEAM_ROOT"
export AGENTWS_TEAM_ROSTER="$TEAM_FILE"
export AGENTWS_TEAM_PROTOCOL="$PROTOCOL_FILE"
export AGENTWS_TEAM_ROLES_DIR="$ROLES_DIR"
export AGENTWS_TEAM_CONSOLE_ROLE="$CONSOLE_ROLE"
export AGENTWS_WORKSPACE="$WORKSPACE"
export AGENTWS_MAX_JOB_ATTEMPTS="$MAX_JOB_ATTEMPTS"

mkdir -p "$RUN_DIR"

line_no=0
pids=""

stop_team() {
    echo "stopping AgentWS team" >&2
    for pid in $pids; do
        kill "$pid" 2>/dev/null || true
    done
    wait 2>/dev/null || true
    exit 130
}

trap stop_team INT TERM

while IFS= read -r line || [ -n "$line" ]; do
    line_no=$((line_no + 1))
    line="${line#"${line%%[![:space:]]*}"}"
    case "$line" in
        ""|\#*) continue ;;
    esac

    set -- $line
    [ "$#" -ge 3 ] || die "$TEAM_FILE:$line_no: expected <name> <role> <agent> [model]"
    [ "$#" -le 4 ] || die "$TEAM_FILE:$line_no: too many fields"

    name="$1"
    role="$2"
    agent="$3"
    model="${4:-}"

    validate_agent_id "$name"
    validate_role "$role"
    [ -f "$ROLES_DIR/$role.md" ] || die "$TEAM_FILE:$line_no: role file not found: $ROLES_DIR/$role.md"
    if [ "$agent" != "pi-interactive" ]; then
        agent_flag "$agent" >/dev/null
    fi

    (
        consecutive_failures=0
        retry_delay="$RETRY_INITIAL_SECONDS"
        suspended_file="$RUN_DIR/$name.suspended"
        rm -f "$suspended_file"
        while :; do
            headless_arg="--headless"
            [ "$VERBOSE" -eq 1 ] && headless_arg=""
            if run_agent_once "$headless_arg" "$agent" "$model" "$role" "$name"; then
                rc=0
            else
                rc="$?"
            fi
            printf '%s\n' "$rc" > "$RUN_DIR/$name.last-status" 2>/dev/null || true
            printf '%s\n' "$(timestamp)" > "$RUN_DIR/$name.last-exit" 2>/dev/null || true
            if [ "$rc" -eq "$FATAL_AGENT_EXIT" ]; then
                echo "agent $name suspended immediately after fatal safety status $rc; inspect its logs and job state before restarting the Cyclo container" >&2
                {
                    printf 'failures=%s\n' "$consecutive_failures"
                    printf 'last_status=%s\n' "$rc"
                    printf 'reason=fatal-agent-safety-error\n'
                    printf 'suspended_at=%s\n' "$(timestamp)"
                } > "$suspended_file"
                while :; do
                    sleep 3600
                done
            fi
            if [ "$rc" -eq 0 ]; then
                consecutive_failures=0
                retry_delay="$RETRY_INITIAL_SECONDS"
                sleep 1
                continue
            fi

            consecutive_failures=$((consecutive_failures + 1))
            if [ "$consecutive_failures" -ge "$MAX_CONSECUTIVE_FAILURES" ]; then
                {
                    printf 'failures=%s\n' "$consecutive_failures"
                    printf 'last_status=%s\n' "$rc"
                    printf 'suspended_at=%s\n' "$(timestamp)"
                } > "$suspended_file"
                echo "agent $name suspended after $consecutive_failures consecutive failures; restart the Cyclo container after correcting the cause" >&2
                # Keep the team supervisor alive so Docker's restart policy cannot
                # reset this in-memory circuit breaker into another crash loop.
                while :; do
                    sleep 3600
                done
            fi

            echo "agent $name exited with status $rc; retry $consecutive_failures/$MAX_CONSECUTIVE_FAILURES in ${retry_delay}s" >&2
            sleep "$retry_delay"
            if [ "$retry_delay" -lt "$RETRY_MAX_SECONDS" ]; then
                retry_delay=$((retry_delay * 2))
                if [ "$retry_delay" -gt "$RETRY_MAX_SECONDS" ]; then
                    retry_delay="$RETRY_MAX_SECONDS"
                fi
            fi
        done
    ) &
    pid="$!"
    pids="$pids $pid"
    printf '%s\n' "$pid" > "$RUN_DIR/$name.pid"
    echo "started $name ($role, $agent${model:+, $model}) pid=$pid"
done < "$TEAM_FILE"

[ -n "$pids" ] || die "team file has no agents: $TEAM_FILE"

wait
