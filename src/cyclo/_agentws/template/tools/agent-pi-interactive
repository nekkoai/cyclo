#!/usr/bin/env python3
# SPDX-License-Identifier: MIT
"""Run one named AgentWS Pi agent in RPC mode with external FIFO input."""

from __future__ import annotations

import argparse
import fcntl
import importlib.machinery
import json
import os
import shutil
import signal
import stat
import subprocess
import sys
import threading
import time
import traceback
from pathlib import Path
from typing import Any


SCRIPT_DIR = Path(__file__).resolve().parent
ROOT = SCRIPT_DIR.parent
agent_mod = importlib.machinery.SourceFileLoader("agentws_agent", str(SCRIPT_DIR / "agent")).load_module()


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(description="Run one named interactive Pi AgentWS agent.")
    parser.add_argument("--console", action="store_true", help="run the built-in AgentWS console agent")
    parser.add_argument("--headless", action="store_true", help="Do not mirror rendered transcript output to stdout")
    parser.add_argument("-m", "--model")
    parser.add_argument("role", nargs="?")
    parser.add_argument("agent_name", nargs="?")
    args = parser.parse_args()
    if args.console:
        args.role = args.role or os.environ.get("AGENTWS_TEAM_CONSOLE_ROLE", "console")
        args.agent_name = args.agent_name or "console"
    elif not args.role or not args.agent_name:
        parser.error("role and agent_name are required unless --console is used")
    return args


def ensure_fifo(path: Path) -> None:
    try:
        mode = path.stat().st_mode
        if stat.S_ISFIFO(mode):
            return
        path.unlink()
    except FileNotFoundError:
        pass
    os.mkfifo(path, 0o600)


def write_json_line(stream, value: dict[str, Any], lock: threading.Lock) -> bool:
    with lock:
        if stream.closed:
            return False
        try:
            stream.write(json.dumps(value) + "\n")
            stream.flush()
            return True
        except BrokenPipeError:
            return False


def acquire_interactive_lock(agent_dir: Path, agent_name: str):
    lock_file = (agent_dir / "interactive.lock").open("w", encoding="utf-8")
    try:
        fcntl.flock(lock_file.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        lock_file.close()
        agent_mod.die(f"interactive agent '{agent_name}' is already running")
    lock_file.write(f"{os.getpid()}\n")
    lock_file.flush()
    return lock_file


def read_job_status(job_dir: Path) -> str:
    try:
        return (job_dir / "status").read_text(encoding="utf-8").strip()
    except OSError:
        return ""


def read_job_owner(job_dir: Path) -> str:
    try:
        return (job_dir / "agent-id").read_text(encoding="utf-8").strip()
    except OSError:
        return ""


def build_prompt(
    agent_name: str,
    role: str,
    console: bool,
    workspace: Path,
    protocol_file: Path,
    role_file: Path,
    protocol_text: str,
    role_text: str,
    project_file: Path | None = None,
    project_text: str = "",
) -> str:
    return agent_mod.build_initial_prompt(
        agent_name,
        role,
        ROOT,
        workspace,
        protocol_file,
        role_file,
        protocol_text,
        role_text,
        console=console,
        project_file=project_file,
        project_text=project_text,
    )


def main() -> int:
    args = parse_args()
    agent_mod.validate_name("role", args.role)
    agent_mod.validate_name("agent ID", args.agent_name)
    workspace = agent_mod.configured_workspace(ROOT)

    if shutil.which("pi") is None:
        agent_mod.die("required command not found: pi")
    try:
        agent_mod.enable_child_subreaper()
    except OSError as exc:
        agent_mod.die(f"cannot establish the agent process fence: {exc}")

    protocol_file, role_file, protocol_text, role_text = agent_mod.load_team_context(ROOT, args.role)
    project_file, project_text = agent_mod.load_project_context(ROOT)
    max_job_attempts = agent_mod.positive_env_int(
        "AGENTWS_MAX_JOB_ATTEMPTS", agent_mod.DEFAULT_MAX_JOB_ATTEMPTS
    )

    agent_dir_out = agent_mod.run_bin(
        ROOT, "agent-new", args.agent_name, args.role
    ).stdout.strip()
    if not agent_dir_out:
        agent_mod.die("agent-new returned no agent directory")
    agent_dir = Path(agent_dir_out)
    interactive_lock = acquire_interactive_lock(agent_dir, args.agent_name)

    agent_mod.write_file(agent_dir / "engine", "pi-interactive")
    agent_mod.write_file(agent_dir / "interactive", "1")
    if args.model:
        agent_mod.write_file(agent_dir / "model", args.model)
    agent_mod.write_file(agent_dir / "last_started_at", agent_mod.timestamp())

    job_id = ""
    job_dir: Path | None = None
    previous_attempts = 0
    attempt = 0

    prompt = build_prompt(
        args.agent_name,
        args.role,
        args.console,
        workspace,
        protocol_file,
        role_file,
        protocol_text,
        role_text,
        project_file,
        project_text,
    )
    agent_mod.write_file(agent_dir / "prompt.md", prompt)

    agent_transcript = agent_dir / "transcript.log"
    agent_error = agent_dir / "error.log"
    agent_busy = agent_dir / "busy"
    agent_transcript.touch()
    agent_error.touch()
    agent_mod.write_file(agent_busy, "0\n")

    input_fifo = agent_dir / "input.fifo"
    ensure_fifo(input_fifo)
    fifo_anchor = os.open(input_fifo, os.O_RDWR | os.O_NONBLOCK)

    transcript = agent_mod.Transcript(
        [agent_transcript],
        mirror_stdout=not args.headless,
        mirror_prefix=f"{args.agent_name}: ",
    )
    error_files = [agent_error.open("a", encoding="utf-8", buffering=1)]

    proc: subprocess.Popen[str] | None = None
    stop_event = threading.Event()
    is_streaming = threading.Event()
    initial_command_failed = threading.Event()
    attempt_settled = threading.Event()
    stdin_lock = threading.Lock()
    shutdown_signals = (signal.SIGTERM, signal.SIGINT)
    previous_handlers = {signum: signal.getsignal(signum) for signum in shutdown_signals}
    process_status = 1
    interrupted = False
    settlement_needed = False
    reader_threads: list[threading.Thread] = []
    defer_shutdown = False
    deferred_shutdown_signum = 0
    stored_retry_budget_exhausted = False

    def request_shutdown(signum: int, _frame: Any) -> None:
        nonlocal deferred_shutdown_signum
        stop_event.set()
        if defer_shutdown:
            deferred_shutdown_signum = signum
            return
        raise agent_mod.ShutdownRequested(signum)

    def set_streaming(active: bool) -> None:
        if active:
            is_streaming.set()
        else:
            is_streaming.clear()
        agent_mod.write_file(agent_busy, "1\n" if active else "0\n")

    def transcript_user_message(message: str) -> None:
        transcript.text_block("User", message.rstrip() + "\n", force_heading=True)

    try:
        for signum in shutdown_signals:
            signal.signal(signum, request_shutdown)

        if args.console:
            agent_mod.write_file(agent_dir / "current-job", "")
        else:
            while True:
                agent_mod.run_bin(ROOT, "job-wait", "-r", args.role, capture=True)
                defer_shutdown = True
                try:
                    claim = agent_mod.run_bin(
                        ROOT,
                        "job-claim",
                        "-r",
                        args.role,
                        "--agent-id",
                        args.agent_name,
                    ).stdout.strip()
                    if claim.startswith("CLAIMED: "):
                        job_id = claim.removeprefix("CLAIMED: ").strip()
                        job_dir = ROOT / "jobs" / job_id
                        settlement_needed = True
                    elif claim != "NO_JOBS":
                        agent_mod.die(f"unexpected job-claim output: {claim}")
                finally:
                    defer_shutdown = False
                if deferred_shutdown_signum:
                    raise agent_mod.ShutdownRequested(deferred_shutdown_signum)
                if settlement_needed:
                    break

            agent_mod.write_file(agent_dir / "current-job", job_id)
            assert job_dir is not None
            previous_attempts, attempt = agent_mod.record_job_attempt(
                job_dir, max_job_attempts
            )
            if previous_attempts >= max_job_attempts:
                stored_retry_budget_exhausted = True
                raise agent_mod.StoredRetryBudgetExhausted

            agent_mod.append_job_log(
                job_dir,
                "Interactive transcript",
                f"Agent transcript: agents/{args.agent_name}/transcript.log\n"
                f"Interactive input: agents/{args.agent_name}/input.fifo",
            )

        transcript.event(
            "interactive run start",
            "\n".join(
                part
                for part in (
                    f"agent: {args.agent_name}",
                    f"role: {args.role}",
                    f"job: {job_id}" if job_id else "",
                    "engine: pi-interactive",
                    "mode: console" if args.console else "",
                    f"model: {args.model}" if args.model else "",
                    f"input: agents/{args.agent_name}/input.fifo",
                )
                if part
            ),
        )

        command = ["pi", "--mode", "rpc"]
        if args.model:
            command.extend(["--model", args.model])
        if args.console:
            command.extend(["--append-system-prompt", prompt])
        command.extend(["--session-dir", str(agent_dir / "pi-session")])

        proc = agent_mod.launch_engine(
            command,
            workspace,
            stdin=subprocess.PIPE,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            encoding="utf-8",
            errors="replace",
            bufsize=1,
        )
        assert proc.stdin is not None
        assert proc.stdout is not None
        assert proc.stderr is not None

        def copy_stderr() -> None:
            assert proc is not None and proc.stderr is not None
            for line in proc.stderr:
                for f in error_files:
                    f.write(line)
                    f.flush()
                prefix = f"{args.agent_name}: "
                sys.stderr.write(prefix + line)
                sys.stderr.flush()

        def read_rpc_stdout() -> None:
            renderer = agent_mod.Renderer(transcript, "pi")
            assert proc is not None and proc.stdout is not None
            for raw in proc.stdout:
                try:
                    event = json.loads(raw)
                except json.JSONDecodeError:
                    renderer.render_line(raw)
                    continue
                if isinstance(event, dict):
                    typ = event.get("type")
                    initial_response = (
                        typ == "response" and event.get("id") == "initial"
                    )
                    if typ in ("agent_start", "turn_start"):
                        set_streaming(True)
                    elif typ in ("agent_end", "turn_end"):
                        set_streaming(False)
                    if typ == "message":
                        message = event.get("message")
                        if isinstance(message, dict) and message.get("role") == "assistant" and message.get("stopReason"):
                            set_streaming(False)
                    if typ == "response":
                        set_streaming(False)
                    if typ == "response" and event.get("success") is False:
                        transcript.event("pi rpc error", str(event.get("error") or event))
                        if not args.console and initial_response:
                            initial_command_failed.set()
                            stop_event.set()
                        continue
                    if typ == "agent_settled" and not args.console:
                        set_streaming(False)
                        attempt_settled.set()
                        stop_event.set()
                renderer.render_line(raw)

        def read_browser_input() -> None:
            assert proc is not None and proc.stdin is not None
            while not stop_event.is_set():
                with input_fifo.open("r", encoding="utf-8") as fifo:
                    for line in fifo:
                        if stop_event.is_set():
                            return
                        try:
                            payload = json.loads(line)
                        except json.JSONDecodeError:
                            transcript.event("interactive input ignored", "invalid JSON")
                            continue
                        message = str(payload.get("message") or "").strip()
                        if not message:
                            continue
                        mode = payload.get("mode") or "follow_up"
                        if mode not in {"follow_up", "steer", "prompt"}:
                            mode = "follow_up"
                        if mode == "steer":
                            command_type = "steer"
                        elif is_streaming.is_set():
                            command_type = "follow_up"
                        else:
                            command_type = "prompt"
                        transcript_user_message(message)
                        if command_type in {"prompt", "follow_up"}:
                            set_streaming(True)
                        elif command_type == "steer":
                            set_streaming(False)
                        sent = write_json_line(
                            proc.stdin,
                            {"id": f"web-{time.time_ns()}", "type": command_type, "message": message},
                            stdin_lock,
                        )
                        if not sent:
                            set_streaming(False)

        def watch_job_status() -> None:
            while not stop_event.is_set():
                time.sleep(1)
                status_value = read_job_status(job_dir)
                owner = read_job_owner(job_dir)
                if status_value not in {"claimed", "running"} or (owner and owner != args.agent_name):
                    transcript.event("interactive run closing", f"job status: {status_value or 'missing'}")
                    stop_event.set()
                    if proc is not None and proc.poll() is None:
                        proc.terminate()
                    return

        stderr_thread = threading.Thread(target=copy_stderr, daemon=True)
        stdout_thread = threading.Thread(target=read_rpc_stdout, daemon=True)
        input_thread = threading.Thread(target=read_browser_input, daemon=True)
        reader_threads = [stderr_thread, stdout_thread, input_thread]
        if job_dir is not None:
            reader_threads.append(threading.Thread(target=watch_job_status, daemon=True))
        for thread in reader_threads:
            thread.start()

        if not args.console:
            set_streaming(True)
            if not write_json_line(proc.stdin, {"id": "initial", "type": "prompt", "message": prompt}, stdin_lock):
                initial_command_failed.set()
                stop_event.set()
                set_streaming(False)

        while proc.poll() is None and not stop_event.is_set():
            time.sleep(0.2)

        stop_event.set()
        if proc.poll() is None:
            proc.terminate()
            try:
                proc.wait(timeout=5)
            except subprocess.TimeoutExpired:
                proc.kill()
                proc.wait(timeout=5)
        process_status = proc.returncode if proc.returncode is not None else 1
        transcript.event("interactive run end", f"exit: {process_status}")
    except agent_mod.StoredRetryBudgetExhausted:
        process_status = agent_mod.RETRYABLE_AGENT_EXIT
    except agent_mod.ShutdownRequested as exc:
        transcript.event("interactive run interrupted", f"signal: {exc.signum}")
        process_status = 128 + exc.signum
        interrupted = True
    except Exception as exc:
        print(f"error: interactive agent worker failed: {exc}", file=sys.stderr)
        traceback.print_exc()
        transcript.event("interactive run failed", f"{type(exc).__name__}: {exc}")
        process_status = 1
    finally:
        for signum, handler in previous_handlers.items():
            signal.signal(signum, signal.SIG_IGN)
        stop_event.set()
        agent_mod.write_file(agent_busy, "0\n")
        cleanup_clean = agent_mod.stop_engine_process_group(proc)
        if not cleanup_clean:
            print(
                "error: engine cleanup did not complete; restarting the team container",
                file=sys.stderr,
            )
            process_status = agent_mod.FATAL_AGENT_EXIT
        try:
            os.close(fifo_anchor)
        except OSError:
            pass
        readers_stopped = agent_mod.join_reader_threads(reader_threads)
        cleanup_clean = cleanup_clean and readers_stopped
        if not readers_stopped:
            print(
                "error: interactive reader did not stop; restarting the team container",
                file=sys.stderr,
            )
            process_status = agent_mod.FATAL_AGENT_EXIT
        elif cleanup_clean and not interrupted:
            if initial_command_failed.is_set():
                # Rejection happens before Pi accepts the queued attempt.
                process_status = 1
            elif attempt_settled.is_set():
                # Pi remains alive after a complete RPC run. Queue settlement,
                # not that idle process, determines the worker's final status.
                process_status = 0
        if cleanup_clean and settlement_needed and job_dir is not None:
            if stored_retry_budget_exhausted and not interrupted:
                process_status = agent_mod.settle_stored_retry_budget_exhaustion(
                    ROOT,
                    job_dir,
                    job_id,
                    args.agent_name,
                    maximum=max_job_attempts,
                )
            else:
                process_status = agent_mod.settle_job_after_process(
                    ROOT,
                    job_dir,
                    job_id,
                    args.agent_name,
                    process_status=process_status,
                    previous_attempts=previous_attempts,
                    attempt=attempt,
                    maximum=max_job_attempts,
                    interrupted=interrupted,
                    label="Interactive agent",
                )
        interactive_lock.close()
        try:
            input_fifo.unlink()
        except OSError:
            pass
        transcript.close()
        for f in error_files:
            f.close()
        for signum, handler in previous_handlers.items():
            signal.signal(signum, handler)
    return process_status


if __name__ == "__main__":
    raise SystemExit(main())
