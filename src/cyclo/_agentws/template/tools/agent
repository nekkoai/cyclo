ENGINE_STOP_SECONDS = 2.0
PROVIDER_RUNTIME_HEALTH_ENV = "CYCLO_PROVIDER_RUNTIME_HEALTH_URL"
PROVIDER_RUNTIME_BOOT_ID_HEADER = "X-Cyclo-Runtime-Boot-ID"
PROVIDER_RUNTIME_BOOT_ID_RE = re.compile(r"^[a-f0-9]{32}$")
PROVIDER_RUNTIME_HEALTH_TIMEOUT_SECONDS = 1.0
PROVIDER_RUNTIME_HEALTH_RETRY_SECONDS = 1.0
