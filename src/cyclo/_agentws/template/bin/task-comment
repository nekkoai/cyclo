#!/bin/sh
# SPDX-License-Identifier: MIT
set -eu

AGENTWS_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
. "$AGENTWS_ROOT/bin/lib-agentws"

usage() {
    echo "Usage: task-comment <task-id> <message>"
    exit 1
}

[ "$#" -ge 2 ] || usage

TASK_ID="$1"
shift
MESSAGE="$*"

validate_task_id "$TASK_ID"
[ -n "$MESSAGE" ] || die "message required"
require_tasks_dir

TASK_DIR="$TASKS_DIR/$TASK_ID"

[ -e "$TASK_DIR" ] || [ -L "$TASK_DIR" ] \
    || die "task '$TASK_ID' does not exist"
acquire_task_control_lock "$TASK_DIR"
require_task_record_locked "$TASK_DIR"
append_task_log "$TASK_DIR" "Comment" "$MESSAGE"
release_task_control_lock

echo "$TASK_ID: comment added"
