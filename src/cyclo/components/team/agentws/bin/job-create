#!/bin/sh
# SPDX-License-Identifier: MIT
set -eu

AGENTWS_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
. "$AGENTWS_ROOT/bin/lib-agentws"

usage() {
    echo "Usage: job-create <job-id> -r <role> -t <task-id> [--terminal-notice-for <job-id>] <spec-file>"
    echo ""
    echo "Create a new job for a role inside a task with a complete spec."
    echo ""
    echo "Options:"
    echo "  -r <role>           Role that should process the job"
    echo "  -t <task-id>        Task this job belongs to"
    echo "  --terminal-notice-for <job-id>"
    echo "               Keep this planner notification unavailable until its source is terminal"
    exit 1
}

cleanup() {
    status=$?
    trap - 0 HUP INT TERM
    set +e
    [ -n "${JOB_STAGE:-}" ] && rm -rf -- "$JOB_STAGE"
    exit "$status"
}

JOB_ID=""
JOB_ROLE=""
TASK_ID=""
SPEC_FILE=""
TERMINAL_NOTICE_SOURCE=""

while [ "$#" -gt 0 ]; do
    case "$1" in
        -r|--role)
            [ "$#" -ge 2 ] || die "$1 requires a role"
            JOB_ROLE="$2"
            shift 2
            ;;
        -t|--task-id)
            [ "$#" -ge 2 ] || die "$1 requires a task ID"
            TASK_ID="$2"
            shift 2
            ;;
        --terminal-notice-for)
            [ "$#" -ge 2 ] || die "$1 requires a source job ID"
            TERMINAL_NOTICE_SOURCE="$2"
            shift 2
            ;;
        --help|-h)
            usage
            ;;
        *)
            if [ -z "$JOB_ID" ]; then
                JOB_ID="$1"
            elif [ -z "$SPEC_FILE" ]; then
                SPEC_FILE="$1"
            else
                die "unexpected argument '$1'"
            fi
            shift
            ;;
    esac
done

[ -z "$JOB_ID" ] && usage
[ -z "$JOB_ROLE" ] && die "job role required (-r <role>)"
[ -z "$TASK_ID" ] && die "task ID required (-t <task-id>)"
[ -z "$SPEC_FILE" ] && die "spec file required"
[ "$SPEC_FILE" = "-" ] && die "pass a spec file path, not stdin"
[ -f "$SPEC_FILE" ] || die "spec file '$SPEC_FILE' does not exist"
[ -s "$SPEC_FILE" ] || die "spec file '$SPEC_FILE' is empty"

validate_job_id "$JOB_ID"
validate_role "$JOB_ROLE"
validate_task_id "$TASK_ID"
require_jobs_dir
require_tasks_dir

if [ -n "$TERMINAL_NOTICE_SOURCE" ]; then
    validate_job_id "$TERMINAL_NOTICE_SOURCE"
    [ "$JOB_ROLE" = "planner" ] \
        || die "--terminal-notice-for requires role 'planner'"
    SOURCE_JOB_DIR="$JOBS_DIR/$TERMINAL_NOTICE_SOURCE"
    [ -d "$SOURCE_JOB_DIR" ] && [ ! -L "$SOURCE_JOB_DIR" ] \
        || die "source job '$TERMINAL_NOTICE_SOURCE' does not exist or is not a real directory"
    for source_name in role task-id status .control.lock; do
        [ -f "$SOURCE_JOB_DIR/$source_name" ] && [ ! -L "$SOURCE_JOB_DIR/$source_name" ] \
            || die "source job '$TERMINAL_NOTICE_SOURCE' has invalid $source_name"
    done
    SOURCE_ROLE="$(cat "$SOURCE_JOB_DIR/role" 2>/dev/null || true)"
    SOURCE_TASK_ID="$(cat "$SOURCE_JOB_DIR/task-id" 2>/dev/null || true)"
    SOURCE_STATUS="$(read_status "$SOURCE_JOB_DIR")"
    validate_role "$SOURCE_ROLE"
    validate_task_id "$SOURCE_TASK_ID"
    [ "$SOURCE_ROLE" != "planner" ] \
        || die "planner jobs do not require planner notifications"
    [ "$SOURCE_TASK_ID" = "$TASK_ID" ] \
        || die "source job '$TERMINAL_NOTICE_SOURCE' belongs to task '$SOURCE_TASK_ID', not '$TASK_ID'"
    case "$SOURCE_STATUS" in
        claimed|running) ;;
        *) die "cannot prepare planner notification for source job '$TERMINAL_NOTICE_SOURCE' from status '$SOURCE_STATUS'" ;;
    esac
fi

[ -d "$TASKS_DIR/$TASK_ID" ] || die "task '$TASK_ID' does not exist"

JOB_DIR="$JOBS_DIR/$JOB_ID"
JOB_STAGE=""

[ -e "$JOB_DIR" ] && die "job '$JOB_ID' already exists"

trap cleanup 0
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM
JOB_STAGE="$(mktemp -d "$JOBS_DIR/.job-create+XXXXXX")" \
    || die "cannot create staging directory for job '$JOB_ID'"
chmod 700 "$JOB_STAGE"

mkdir "$JOB_STAGE/workspace"
cp -- "$SPEC_FILE" "$JOB_STAGE/spec.md"

write_file_atomic "$JOB_STAGE/role" "$JOB_ROLE"
write_file_atomic "$JOB_STAGE/task-id" "$TASK_ID"
touch "$JOB_STAGE/log.md"
: > "$JOB_STAGE/.control.lock"
[ -z "$TERMINAL_NOTICE_SOURCE" ] \
    || write_file_atomic "$JOB_STAGE/.terminal-notice-source" "$TERMINAL_NOTICE_SOURCE"
write_file_atomic "$JOB_STAGE/status" "pending"

# The rename is the only publication point. GNU mv -n returns success when it
# declines to replace a destination, so the surviving source detects that case.
mv -nT -- "$JOB_STAGE" "$JOB_DIR" \
    || die "failed to publish job '$JOB_ID': $JOB_DIR"
[ ! -e "$JOB_STAGE" ] \
    || die "job '$JOB_ID' already exists"
JOB_STAGE=""

echo "created: $JOB_DIR (task: $TASK_ID, role: $JOB_ROLE)"
echo "spec: $JOB_DIR/spec.md"
